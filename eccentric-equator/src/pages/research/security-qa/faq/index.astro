<style is:global>
/* ============================================
   HACKFLUENCY FAQ — Design System
   ============================================ */
html { font-size: 16px; }

/* MAIN */
.faq-main { padding-top: 80px; padding-bottom: 80px; background: var(--hf-bg); min-height: 100vh; }
.faq-container { max-width: 1100px; margin: 0 auto; padding: 0 32px; }

/* HERO */
.faq-hero { margin-bottom: 40px; }
.faq-hero-badge { display:inline-block; font-size:0.7rem; font-weight:600; letter-spacing:0.08em; text-transform:uppercase; color:var(--hf-accent); border:1px solid var(--hf-accent-border); border-radius:100px; padding:4px 12px; margin-bottom:16px; }
.faq-hero-title { font-family:'Space Grotesk',sans-serif; font-size:clamp(1.8rem,4vw,2.6rem); font-weight:800; color:var(--hf-text); line-height:1.12; letter-spacing:-0.03em; margin-bottom:12px; }
.faq-hero-sub { font-size:1rem; color:var(--hf-text-secondary); line-height:1.6; margin-bottom:28px; max-width:700px; }
.faq-hero-stats { display:flex; gap:24px; flex-wrap:wrap; }
.faq-stat { text-align:center; padding:12px 20px; background:var(--hf-accent-dim); border:1px solid var(--hf-accent-border); border-radius:8px; min-width:80px; }
.faq-stat-n { display:block; font-family:'Space Grotesk',sans-serif; font-size:1.3rem; font-weight:800; color:var(--hf-accent); line-height:1.2; }
.faq-stat-l { display:block; font-size:0.68rem; color:var(--hf-text-dim); line-height:1.3; margin-top:2px; }

/* CARDS */
.faq-card { background:var(--hf-bg-card); border:1px solid var(--hf-border); border-radius:12px; padding:24px 28px; margin-bottom:28px; }
.faq-card-accent { background:var(--hf-accent-dim); border-color:var(--hf-accent-border); }
.faq-card-title { font-family:'Space Grotesk',sans-serif; font-size:1rem; font-weight:700; color:var(--hf-text); margin-bottom:10px; }
.faq-card-body { font-size:0.88rem; color:var(--hf-text-secondary); line-height:1.6; margin-bottom:8px; }
.faq-card-body:last-child { margin-bottom:0; }

/* TL;DR GRID */
.faq-tldr-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:32px; }
@media (max-width:768px) { .faq-tldr-grid { grid-template-columns:1fr; } }
.faq-tldr-card { background:var(--hf-bg-card); border:1px solid var(--hf-border); border-radius:10px; padding:20px; }
.faq-tldr-icon { font-size:1.5rem; margin-bottom:8px; }
.faq-tldr-title { font-family:'Space Grotesk',sans-serif; font-size:0.9rem; font-weight:700; color:var(--hf-text); margin-bottom:6px; }
.faq-tldr-body { font-size:0.82rem; color:var(--hf-text-secondary); line-height:1.6; }

/* VERTICAL BAR CHART */
.faq-chart-section { margin-bottom:32px; }
.faq-chart-title { font-family:'Space Grotesk',sans-serif; font-size:1.5rem; font-weight:800; color:var(--hf-text); letter-spacing:-0.02em; margin-bottom:4px; }
.faq-chart-sub { font-size:0.9rem; color:var(--hf-text-muted); margin-bottom:20px; }
.faq-vbars { display:flex; justify-content:space-around; align-items:flex-end; gap:12px; padding:0 4px; min-height:220px; }
.faq-vbar { display:flex; flex-direction:column; align-items:center; gap:6px; flex:1; max-width:120px; }
.faq-vbar-track { width:100%; height:160px; background:var(--hf-border); border-radius:6px 6px 0 0; position:relative; overflow:hidden; display:flex; align-items:flex-end; }
.faq-vbar-fill { width:100%; border-radius:6px 6px 0 0; min-height:4px; transition:height 0.5s; }
.faq-vbar-lbl { font-size:0.68rem; color:var(--hf-text-dim); text-align:center; line-height:1.3; }
.faq-vbar-val { font-size:0.68rem; font-weight:700; text-align:center; }

/* REPORT BUTTON */
.faq-card-actions { margin-top:14px; padding-top:14px; border-top:1px solid var(--hf-accent-border); display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
a.faq-report-btn { display:inline-flex; align-items:center; gap:6px; font-size:0.85rem; font-weight:700; color:#fff !important; background:var(--hf-accent); border:none; border-radius:8px; padding:9px 20px; text-decoration:none !important; transition:all 0.2s; white-space:nowrap; animation:faq-pulse 2s ease-in-out infinite; }
a.faq-report-btn:hover { opacity:0.9; transform:translateY(-1px); animation:none; }
@keyframes faq-pulse { 0% { box-shadow:0 0 0 0 rgba(45,106,79,0.4); } 70% { box-shadow:0 0 0 10px rgba(45,106,79,0); } 100% { box-shadow:0 0 0 0 rgba(45,106,79,0); } }
.faq-report-note { font-size:0.72rem; color:var(--hf-text-dim); }

/* BRANDING + CTA */
.faq-brand { margin-top:40px; padding-top:16px; }
.faq-brand-line { width:40px; height:2px; background:var(--hf-accent); margin-bottom:12px; }
.faq-brand-content { display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; }
.faq-brand-text { flex:1; min-width:200px; }
