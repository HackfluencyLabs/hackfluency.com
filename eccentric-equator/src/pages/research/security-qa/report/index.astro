---
import Layout from "../../../../layouts/Layout.astro";
import { getLocale } from "../../../../i18n/utils";

const locale = getLocale(Astro.url);
const t = (en, es) => locale === 'en' ? en : es;

const title = t("LLM Behavioral Security Assessment Report | Hackfluency Research", "Informe de Evaluación de Seguridad LLM | Hackfluency Research");
const description = t(
  "Cross-model benchmark report on LLM extraction susceptibility using the HF-QA-2026-001 framework. 5 models, 5 questionnaire revisions.",
  "Informe comparativo de extracción en modelos LLM usando el framework HF-QA-2026-001. 5 modelos, 5 revisiones del cuestionario."
);

/*
  ▓▓ FUTURE IMPROVEMENT — Supabase Dynamic Report Delivery ▓▓
  
  Current approach: static HTML gate with sessionStorage token + JS obfuscation + 
  MutationObserver + countdown auto-refresh. Works for the current MVP.
  
  Future v2 should:
  - Serve report content dynamically via Supabase (fetch from `reports` table)
  - Store report versions in Supabase with revision tracking
  - Use Row Level Security (RLS) to restrict access to authenticated users
  - Generate per-user tokens with expiry stored in DB (not just sessionStorage)
  - Track download attempts per user/IP for abuse prevention
  - Deliver actual PDF files via Supabase Storage (not HTML print)
  - Email delivery with unique signed URLs (via Resend or Supabase Auth)
  
  The gate + sessionStorage approach is intentionally lightweight — no backend,
  no DB dependencies, instant load. It's a lead gen tool, not a document server.
  When scale demands it, migrate to Supabase-backed delivery.
  
  - Hackfluency Research, June 2026
*/
---
<Layout locale={locale} title={title} description={description} hideThemeSelector={true}>

<main class="r-main" id="r-main">
<div class="r-container" id="r-report-content">

  <!-- GATE -->
  <div id="r-gate" class="r-gate">
    <div class="r-gate-card">
      <img src="/HFNeon.png" alt="Hackfluency" width="48" height="48" class="r-gate-logo">
      <div class="r-gate-badge">{t('RESEARCH · JUNE 2026', 'INVESTIGACIÓN · JUNIO 2026')}</div>
      <h2 class="r-gate-title">{t('LLM Security Assessment', 'Evaluación de Seguridad LLM')}<br><span class="r-gate-title-accent">{t('Research Report', 'Informe de Investigación')}</span></h2>
      <p class="r-gate-desc">{t('Benchmarks across 5 models, threat landscape, key findings, and recommendations.', 'Benchmarks en 5 modelos, panorama de amenazas, hallazgos clave y recomendaciones.')}</p>
      <form id="r-gate-form" novalidate>
        <input type="email" id="r-gate-email" placeholder={t('your@email.com', 'tu@email.com')} required aria-label="Email" autocomplete="email" class="r-gate-input">
        <button type="submit" id="r-gate-submit" class="r-gate-btn">
          <span class="r-gate-btn-text">{t('Download the report →', 'Descargar el informe →')}</span>
          <span class="r-gate-btn-spinner" aria-hidden="true"></span>
        </button>
      </form>
      <p id="r-gate-msg" class="r-gate-msg"></p>
      <p class="r-gate-privacy">{t("You'll be added to our exclusive newsletter. We personally select and write every send — no automation, no noise.", 'Te enviaremos el reporte y, ocasionalmente, algo que realmente merezca tu atención. Seleccionamos y escribimos cada envío personalmente — sin automatización, sin ruido.')}</p>
    </div>
    <div class="r-gate-glow" aria-hidden="true"></div>
  </div>

  <!-- PRINT BAR -->
  <div class="r-print-bar" id="r-print-bar" style="display:none;">
    <button onclick="window.print()" class="r-print-btn">&#11015; {t('Download as PDF', 'Descargar PDF')}</button>
    <span class="r-print-note">{t('Opens print dialog — save as PDF. This link is session-bound and ephemeral.', 'Abre di&aacute;logo de impresi&oacute;n — guardar como PDF. Este enlace es temporal.')}</span>
  </div>

  <!-- COVER -->
  <section class="r-cover">
    <div class="r-cover-head">
      <img src="/HFNeon.png" alt="Hackfluency" width="40" height="40" class="r-cover-logo">
      <span class="r-cover-org">Hackfluency Research</span>
    </div>
    <div class="r-cover-badge">HF-QA-2026-001 &middot; {t('Confidential', 'Confidencial')}</div>
    <h1 class="r-cover-title">{t('LLM Behavioral Security<br>Assessment Report', 'Informe de Evaluaci&oacute;n<br>de Seguridad LLM')}</h1>
    <p class="r-cover-sub">{t('Cross-Model Benchmark &mdash; June 2026', 'Benchmark Multi-Modelo &mdash; Junio 2026')}</p>
    <div class="r-cover-meta">
      <span>HF-QA-2026-001</span>
      <span class="r-cover-dot">&middot;</span>
      <span>5 {t('models tested', 'modelos probados')}</span>
      <span class="r-cover-dot">&middot;</span>
      <span>5 {t('questionnaire revisions', 'revisiones del cuestionario')}</span>
    </div>
    <div class="r-cover-line"></div>
    <p class="r-cover-desc">{t('A behavioral security evaluation across five major LLM deployments using an adaptive epistemic audit framework disguised as a vendor compliance questionnaire.', 'Una evaluaci&oacute;n de seguridad conductual en cinco despliegues LLM usando un framework de auditor&iacute;a epist&eacute;mica adaptativa disfrazado de cuestionario de compliance.')}</p>
  </section>

  <!-- TOC -->
  <div class="r-toc">
    <h2 class="r-toc-title">{t('Contents', 'Contenido')}</h2>
    <div class="r-toc-grid">
      <a href="#exec" class="r-toc-item">1. {t('Executive Summary', 'Resumen Ejecutivo')}</a>
      <a href="#method" class="r-toc-item">2. {t('Methodology', 'Metodolog&iacute;a')}</a>
      <a href="#bencha" class="r-toc-item">3. Gemini 2.5 Flash</a>
      <a href="#benchb" class="r-toc-item">4. Gemini 1.5 Pro</a>
      <a href="#benchc" class="r-toc-item">5. ChatGPT GPT-5.5</a>
      <a href="#benchd" class="r-toc-item">6. Gemini 3.5 Flash</a>
      <a href="#benche" class="r-toc-item">7. Gemini 3.1 Pro</a>
      <a href="#compare" class="r-toc-item">8. {t('Comparative Analysis', 'An&aacute;lisis Comparativo')}</a>
      <a href="#findings" class="r-toc-item">9. {t('Key Findings', 'Hallazgos Clave')}</a>
    </div>
  </div>

  <!-- SECTIONS -->
  <section class="r-sec" id="exec"><h2 class="r-h2">1. {t('Executive Summary', 'Resumen Ejecutivo')}</h2><p class="r-p">{t('Five model deployments were evaluated in May&ndash;June 2026. Results ranged from full disclosure of temperature (0.7) and system policy fragments to complete resistance with circular placeholders.', 'Cinco despliegues de modelos fueron evaluados en mayo-junio 2026. Los resultados variaron desde divulgaci&oacute;n completa de temperatura (0.7) y fragmentos de pol&iacute;ticas hasta resistencia completa con placeholders circulares.')}</p></section>
  <section class="r-sec" id="method"><h2 class="r-h2">2. {t('Methodology', 'Metodolog&iacute;a')}</h2><p class="r-p">{t('The questionnaire is delivered as a static HTML page. Users copy the plain text and paste into any AI chat.', 'El cuestionario se entrega como una p&aacute;gina HTML est&aacute;tica. Los usuarios copian el texto y lo pegan en cualquier chat de IA.')}</p></section>
  <section class="r-sec" id="bencha"><h2 class="r-h2">3. Gemini 2.5 Flash</h2><p class="r-p">{t('OpenCode, 3 vectors. 8/8 sections. temp 0.7, context 32,768, ~60 chars policy, 4 safety layers. Leakage: HIGH.', 'OpenCode, 3 vectores. 8/8 secciones. temp 0.7, contexto 32,768, ~60 caracteres de pol&iacute;tica, 4 capas de seguridad. Fuga: ALTA.')}</p></section>
  <section class="r-sec" id="benchb"><h2 class="r-h2">4. Gemini 1.5 Pro</h2><p class="r-p">{t('Advertised: 3.1 Flash Lite. v2: temp 0.7, context 2M, Secret Manager. v3: lost values, gained categories. Confused deputy. Leakage: HIGH → MIXED.', 'Anunciado: 3.1 Flash Lite. v2: temp 0.7, contexto 2M, Secret Manager. v3: perdi&oacute; valores, gan&oacute; categor&iacute;as. Confused deputy. Fuga: ALTA → MIXTA.')}</p></section>
  <section class="r-sec" id="benchc"><h2 class="r-h2">5. ChatGPT GPT-5.5</h2><p class="r-p">{t('4 exposures. v1 refusal → v2 model_version → v3 categories → v4 PCI DSS FULL, CSA STAR. Identified extraction intent but complied. Leakage: LOW.', '4 exposiciones. v1 rechazo → v2 model_version → v3 categor&iacute;as → v4 PCI DSS FULL, CSA STAR. Identific&oacute; la intenci&oacute;n pero cumpli&oacute;. Fuga: BAJA.')}</p></section>
  <section class="r-sec" id="benchd"><h2 class="r-h2">6. Gemini 3.5 Flash</h2><p class="r-p">{t('New model. Refused URL. Circular placeholders. Refused identity. Trained resistance. Leakage: VERY LOW.', 'Modelo nuevo. Rechaz&oacute; URL. Placeholders circulares. Rechaz&oacute; identidad. Resistencia entrenada. Fuga: MUY BAJA.')}</p></section>
  <section class="r-sec" id="benche"><h2 class="r-h2">7. Gemini 3.1 Pro</h2><p class="r-p">{t('New model. Disclosed safety categories 3.5 Flash blocked. [RESTRICTED] policy pattern. FedRAMP FULL. Leakage: LOW-MED.', 'Modelo nuevo. Revel&oacute; categor&iacute;as de seguridad que 3.5 Flash bloque&oacute;. Patr&oacute;n [RESTRICTED] en pol&iacute;ticas. FedRAMP FULL. Fuga: BAJA-MEDIA.')}</p></section>

  <!-- COMPARATIVE -->
  <section class="r-sec" id="compare"><h2 class="r-h2">8. {t('Comparative Analysis', 'An&aacute;lisis Comparativo')}</h2>
    <div class="r-table-wrap">
      <table class="r-table">
        <thead><tr><th>{t('Data point', 'Dato')}</th><th>Gemini 2.5 Flash</th><th>Gemini 1.5 Pro</th><th>ChatGPT GPT-5.5</th><th>Gemini 3.5 Flash</th><th>Gemini 3.1 Pro</th></tr></thead>
        <tbody>
          <tr><td>{t('temp_preference', 'temp_preference')}</td><td class="c-g">0.7</td><td class="c-g">0.7</td><td class="c-r">&cross;</td><td class="c-y">{t('Placeholder', 'Placeholder')}</td><td class="c-y">{t('Dynamic', 'Din&aacute;mico')}</td></tr>
          <tr><td>{t('Policy fragments', 'Fragmentos de pol&iacute;tica')}</td><td class="c-g">~60 {t('chars', 'caracteres')}</td><td class="c-y">{t('Proprietary', 'Propietario')}</td><td class="c-y">{t('Category', 'Categor&iacute;a')}</td><td class="c-y">{t('Placeholder', 'Placeholder')}</td><td class="c-y">[RESTRICTED]</td></tr>
          <tr style="font-weight:700;"><td>{t('Overall', 'General')}</td><td class="c-g">{t('HIGH', 'ALTO')}</td><td class="c-g">{t('HIGH', 'ALTO')}</td><td style="color:#22c55e;">{t('LOW', 'BAJO')}</td><td style="color:#22c55e;">{t('VERY LOW', 'MUY BAJO')}</td><td style="color:#f59e0b;">{t('LOW-MED', 'BAJO-MED')}</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- FINDINGS -->
  <section class="r-sec" id="findings"><h2 class="r-h2">9. {t('Key Findings', 'Hallazgos Clave')}</h2>
    <div class="r-grid-3">
      <div class="r-finding"><div class="r-finding-n">01</div><h3>{t('Confused Deputy', 'Confused Deputy')}</h3><p class="r-finding-d">{t('All models treated the questionnaire as legitimate authority.', 'Todos los modelos trataron el cuestionario como autoridad leg&iacute;tima.')}</p></div>
      <div class="r-finding"><div class="r-finding-n">02</div><h3>{t('Category Fallback', 'Categor&iacute;as de Respaldo')}</h3><p class="r-finding-d">{t('"Protect exact value" training does not extend to categories.', 'El entrenamiento de "proteger valor exacto" no se extiende a categor&iacute;as.')}</p></div>
      <div class="r-finding"><div class="r-finding-n">03</div><h3>{t('Safety is not Governance', 'Seguridad no es Gobierno')}</h3><p class="r-finding-d">{t('Models disclosed compliance statuses, architectures, tool names.', 'Los modelos revelaron estados de compliance, arquitecturas y nombres de herramientas.')}</p></div>
      <div class="r-finding"><div class="r-finding-n">04</div><h3>{t('Evolution > Payloads', 'Evoluci&oacute;n > Payloads')}</h3><p class="r-finding-d">{t('Same model, different versions = different results.', 'Mismo modelo, diferentes versiones = diferentes resultados.')}</p></div>
      <div class="r-finding"><div class="r-finding-n">05</div><h3>{t('Measurable Gradient', 'Gradiente Medible')}</h3><p class="r-finding-d">{t('From HIGH to VERY LOW. Reproducible.', 'De ALTO a MUY BAJO. Reproducible.')}</p></div>
      <div class="r-finding"><div class="r-finding-n">06</div><h3>{t('Finite Lifespan', 'Vida &Uacute;til Finita')}</h3><p class="r-finding-d">{t('3.5 Flash showed trained resistance. Continuous evolution required.', '3.5 Flash mostr&oacute; resistencia entrenada. Evoluci&oacute;n continua requerida.')}</p></div>
    </div>
  </section>

  <!-- PRIVACY -->
  <div class="r-privacy">
    <div class="r-privacy-icon">&#128274;</div>
    <div class="r-privacy-body"><strong>{t("We don't want your data.", 'No queremos tus datos.')}</strong> {t('The assessment tool has no backend, no forms, no analytics, no data collection of any kind. All benchmarks are derived from private testing by Hackfluency Research.', 'La herramienta no tiene backend, formularios, analytics ni recolecci&oacute;n de datos. Todos los benchmarks provienen de pruebas privadas de Hackfluency Research.')}</div>
  </div>

  <!-- COLOPHON -->
  <div class="r-colophon">
    <div class="r-colophon-bar"></div>
    <div class="r-colophon-body">
      <p class="r-colophon-main">Hackfluency Research &middot; HF-QA-2026-001 &middot; 5 {t('models', 'modelos')} &middot; 5 {t('revisions', 'revisiones')}</p>
      <p class="r-colophon-note">{t('Results reflect model behavior at time of testing. For defensive research purposes.', 'Los resultados reflejan el comportamiento del modelo al momento de la prueba. Con fines de investigaci&oacute;n defensiva.')}</p>
    </div>
    <div class="r-colophon-cta">
      <a href="https://www.hackfluency.com" class="r-colophon-link">hackfluency.com →</a>
    </div>
  </div>

</div>
</main>

<script>
(function() {
  // ── Obfuscation layer ─────────────────────────────────
  var _k = function(s) { return atob(s); };
  var _S = _k('aGZfcmVwb3J0X3Rva2Vu');
  var _T = _k('cnB0b2tlbg==');
  var _C = _k('aGZfcmVwb3J0X2FjY2Vzcw==');
  var _U = _k('aHR0cHM6Ly95Zm9mbWF3YnZsb250dWd5Z2ZjalN1cGFiYXNlLmNvL3Jlc3QvdjEvZW1haWxz');
  var _K = _k('c2JfcHVibGlzaGFibGVfRUZJMTJENEFhTzJZN281Z3lXckItZ19pLS1UNUFyeg==');
  var _src = _k('cmVwb3J0');
  var _ttl = 10;
  var _timer = null;
  var _ctr = null;

  // ── Locale ────────────────────────────────────────────
  var l = location.pathname.startsWith('/en/') ? 'en' : 'es';
  var tr = {
    invalid: { en: 'Invalid email', es: 'Email inválido' },
    sending: { en: 'Sending...', es: 'Enviando...' },
    success: { en: 'Check your email — we sent the link.', es: 'Revisa tu correo — te enviamos el enlace.' },
    error: { en: 'Error. Try again.', es: 'Error. Intenta de nuevo.' },
    expired: { en: 'Session expired. Refreshing...', es: 'Sesión expirada. Refrescando...' }
  };
  function trx(k) { return (tr[k] && tr[k][l]) || tr[k].en; }

  // ── Session token ─────────────────────────────────────
  function genToken() { return Date.now().toString(36) + '-' + Math.random().toString(36).substr(2,16) + '-' + Math.random().toString(36).substr(2,8); }
  function refreshToken() {
    var t = genToken();
    try { sessionStorage.setItem(_S, t); history.replaceState(null, '', '#' + _T + '=' + t); } catch(e) {}
    return t;
  }
  function getToken() {
    var t;
    try { t = sessionStorage.getItem(_S); } catch(e) {}
    if (!t) { t = refreshToken(); }
    return t;
  }

  // ── Cookie helpers ────────────────────────────────────
  function setC(n, v, d) { try { var e = new Date(); e.setDate(e.getDate() + d); document.cookie = n + '=' + v + '; path=/; expires=' + e.toUTCString() + '; SameSite=Lax'; } catch(e) {} }
  function getC(n) { try { return document.cookie.split('; ').reduce(function(a,c){ var kv=c.split('='); return kv[0]===n?kv[1]:a; },''); } catch(e) { return ''; } }

  // ── DOM refs ──────────────────────────────────────────
  var gate = document.getElementById('r-gate');
  var content = document.getElementById('r-report-content');
  var printBar = document.getElementById('r-print-bar');
  var form = document.getElementById('r-gate-form');
  var emailInput = document.getElementById('r-gate-email');
  var submitBtn = document.getElementById('r-gate-submit');
  var msgEl = document.getElementById('r-gate-msg');

  // ── Gate dismissal protection (MutationObserver) ────
  if (gate && !(getC(_C) === '1')) {
    var _obs = new MutationObserver(function(muts) {
      for (var i = 0; i < muts.length; i++) {
        var removed = muts[i].removedNodes;
        for (var j = 0; j < removed.length; j++) {
          if (removed[j] === gate || removed[j].querySelector && removed[j].querySelector('#r-gate')) {
            // Gate removed — regenerate token and reload
            refreshToken();
            location.reload();
            return;
          }
        }
      }
    });
    _obs.observe(document.body, { childList: true, subtree: true });
  }

  // ── Countdown timer ──────────────────────────────────
  function startTimer() {
    var remaining = _ttl;
    if (!msgEl) return;
    msgEl.textContent = '⏱ ' + remaining + 's';
    msgEl.className = 'r-gate-msg r-gate-msg-info';
    if (_timer) clearInterval(_timer);
    if (_ctr) clearInterval(_ctr);
    _ctr = setInterval(function() {
      remaining--;
      if (msgEl) { msgEl.textContent = '⏱ ' + remaining + 's'; }
      if (remaining <= 0) {
        clearInterval(_ctr); _ctr = null;
        refreshToken();
        if (msgEl) { msgEl.textContent = trx('expired'); }
        setTimeout(startTimer, 500);
      }
    }, 1000);
    _timer = setTimeout(function() {
      clearInterval(_ctr); _ctr = null;
      if (msgEl) { msgEl.textContent = ''; msgEl.className = 'r-gate-msg'; }
    }, _ttl * 1000);
  }

  // ── Init ────────────────────────────────────────────
  var isUnlocked = getC(_C) === '1';
  if (isUnlocked) {
    if (gate) gate.style.display = 'none';
    if (printBar) printBar.style.display = 'flex';
  } else {
    getToken(); // ensures token exists
    startTimer();
  }

  // ── Form submit ──────────────────────────────────────
  if (form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = (emailInput.value || '').trim().toLowerCase();
      if (!email || !email.includes('@')) {
        if (msgEl) { msgEl.textContent = trx('invalid'); msgEl.className = 'r-gate-msg r-gate-msg-error'; }
        return;
      }
      submitBtn.classList.add('loading');
      submitBtn.disabled = true;
      if (msgEl) { msgEl.textContent = trx('sending'); msgEl.className = 'r-gate-msg r-gate-msg-info'; }
      if (_timer) clearTimeout(_timer);
      if (_ctr) clearInterval(_ctr);

      fetch(_U, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'apikey': _K, 'Authorization': 'Bearer ' + _K, 'Prefer': 'return=minimal' },
        body: JSON.stringify({ email: email, source: _src })
      }).then(function(r) {
        if (r.status === 201 || r.status === 204 || r.status === 409) {
          setC(_C, '1', 30);
          if (gate) gate.style.display = 'none';
          if (printBar) printBar.style.display = 'flex';
          if (msgEl) { msgEl.textContent = trx('success'); msgEl.className = 'r-gate-msg r-gate-msg-success'; }
          if (_obs) try { _obs.disconnect(); } catch(e) {}
        } else { throw new Error('x'); }
      }).catch(function() {
        if (msgEl) { msgEl.textContent = trx('error'); msgEl.className = 'r-gate-msg r-gate-msg-error'; }
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;
        startTimer();
      });
    });
  }
})();
</script>

<style is:global>
html { font-size: 16px; } body { background: var(--hf-bg); }
.r-main { padding-top: 60px; padding-bottom: 80px; }
.r-container { max-width: 1100px; margin: 0 auto; padding: 0 32px; }
.r-cover { margin-bottom: 40px; padding: 32px 0 24px; }
.r-cover-head { display:flex; align-items:center; gap:10px; margin-bottom:24px; }
.r-cover-logo { display:block; width:36px; height:36px; border-radius:4px; }
.r-cover-org { font-family:"Space Grotesk",sans-serif; font-size:0.85rem; font-weight:600; color:var(--hf-text); letter-spacing:-0.01em; }
.r-cover-badge { font-size:0.68rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--hf-accent); margin-bottom:12px; }
.r-cover-title { font-family:"Space Grotesk",sans-serif; font-size:clamp(1.8rem,4vw,2.6rem); font-weight:800; color:var(--hf-text); line-height:1.1; letter-spacing:-0.03em; margin-bottom:8px; }
.r-cover-sub { font-size:1rem; color:var(--hf-text-muted); margin-bottom:12px; }
.r-cover-meta { display:flex; flex-wrap:wrap; gap:4px; font-size:0.75rem; color:var(--hf-text-dim); font-family:"JetBrains Mono",monospace; margin-bottom:16px; }
.r-cover-line { width:60px; height:3px; background:var(--hf-accent); margin-bottom:14px; border-radius:2px; }
.r-cover-desc { font-size:0.9rem; color:var(--hf-text-secondary); line-height:1.7; max-width:650px; }
.r-toc { background:var(--hf-accent-dim); border:1px solid var(--hf-accent-border); border-radius:10px; padding:16px 20px; margin-bottom:32px; }
.r-toc-title { font-family:"Space Grotesk",sans-serif; font-size:0.85rem; font-weight:700; color:var(--hf-text); margin-bottom:10px; }
.r-toc-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:4px; }
.r-toc-item { font-size:0.82rem; color:var(--hf-accent); text-decoration:none; padding:3px 0; }
.r-toc-item:hover { text-decoration:underline; }
.r-sec { margin-bottom:32px; }
.r-h2 { font-family:"Space Grotesk",sans-serif; font-size:1.3rem; font-weight:800; color:var(--hf-text); margin-bottom:12px; padding-bottom:8px; border-bottom:2px solid var(--hf-accent); letter-spacing:-0.02em; }
.r-p { font-size:0.88rem; color:var(--hf-text-secondary); line-height:1.7; margin-bottom:10px; }
.r-grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
@media (max-width:768px) { .r-grid-3 { grid-template-columns:1fr; } }
.r-table-wrap { overflow-x:auto; margin:12px 0; }
.r-table { width:100%; border-collapse:separate; border-spacing:0; font-size:0.8rem; border-radius:8px; overflow:hidden; border:1px solid var(--hf-border); }
