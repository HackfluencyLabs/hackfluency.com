---
import Layout from '../../../../layouts/Layout.astro';
import ArticleGate from '../../../../components/articles/ArticleGate.astro';
import { readFileSync } from 'fs';

const locale = 'es';
const htmlContent = readFileSync('src/assets/reports/convergencia_normativa.html', 'utf-8');
---

<Layout
  locale={locale}
  title="Convergencia Normativa Chile 2026 — Mapa de Controles vs Leyes | Hackfluency"
  description="Mapa interactivo con 31 controles y 5 marcos legales (Ley 21.663, 21.719, 21.595, NCG 538, BOD 26-04). Cada conexión revela el artículo exacto. ¿Qué controles cubren tu obligación?"
  hideThemeSelector={true}
  viewportDesktop={true}
>
  <Fragment set:html={htmlContent} />
  <ArticleGate locale={locale} />
</Layout>
