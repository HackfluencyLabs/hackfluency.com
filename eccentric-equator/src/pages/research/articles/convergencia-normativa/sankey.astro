<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CHILE 2026 JUN · Controles vs Leyes — Observatorio</title>
<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%}
body{background:white;font-family:Segoe UI,Inter,Arial,sans-serif;color:#1A1A18;font-size:13px;line-height:1.4;display:flex;flex-direction:column;padding:4px 0 2px}
.chart-box{display:flex;flex-direction:column;flex:1;min-height:0}
#chart-sankey{width:100%;flex:1;min-height:0}
#lawFilters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:6px;padding:0 14px}
.lawFilter{padding:3px 12px;border-radius:100px;font-size:11px;font-weight:600;cursor:pointer;border:2px solid transparent;transition:all 0.2s;background:transparent;color:#6C757D;font-family:inherit}
.lawFilter:hover{border-color:currentColor}
</style>
</head>
<body>
<div class="chart-box">
  <div id="lawFilters">
    <button class="lawFilter" data-law="21.663" style="color:#DC3545;border-color:#DC3545" onclick="toggleLawFilter('21.663')">Ley 21.663</button>
    <button class="lawFilter" data-law="21.719" style="color:#5B6ABF" onclick="toggleLawFilter('21.719')">Ley 21.719</button>
    <button class="lawFilter" data-law="21.595" style="color:#6F42C1" onclick="toggleLawFilter('21.595')">Ley 21.595</button>
    <button class="lawFilter" data-law="NCG" style="color:#E67E22" onclick="toggleLawFilter('NCG')">NCG 538</button>
    <button class="lawFilter" data-law="BOD" style="color:#28A745" onclick="toggleLawFilter('BOD')">BOD 26-04</button>
  </div>
  <div style="position:relative;flex:1;min-height:0;display:flex">
    <div id="chart-sankey"></div>
    <div id="sankey-overlay" style="position:absolute;top:0;left:0;width:100%;height:100%;background:white;pointer-events:none;transition:opacity 0.7s ease-out;z-index:10;"></div>
  </div>
</div>

<script is:inline>
(function initChart(){if(typeof echarts==='undefined'){setTimeout(initChart,100);return;}
