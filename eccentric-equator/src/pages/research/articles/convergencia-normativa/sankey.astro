---
// ===== Sankey ligero: replica EXACTA del canonico (convergencia_normativa.html) =====
// 3 capas: Leyes (izq) -> Estandares (centro) -> Controles (der)
// Sin interaccion. Unica animacion: flujo de aristas >=60fps (CSS stroke-dashoffset seamless).
// Semantica de color (estatica, la del hover/filtro del canonico):
//   rojo solido   = obligatorio (ley 'exige' el estandar / control de estandar exigido)
//   azul punteado = satisface (referencia) ley->estandar
//   gris punteado = control transversal (2+ estandares) o estandar no obligatorio (BOD voluntaria)

// --- Datos canonicos (fieles a STD_DEFS / LEY_CODES / LAWCOL del reporte) ---
const LEYES = [
  { code: '21.663', label: '21.663', color: '#DC3545' },
  { code: '21.719', label: '21.719', color: '#5B6ABF' },
  { code: '21.595', label: '21.595', color: '#6F42C1' },
  { code: 'NCG',    label: 'NCG 538', color: '#E67E22' },
];
const STD = [
  { n: 'ISO 27001 (SGSI)',                    ley: { '21.663': 'exige', '21.719': 'satisface' }, ctrls: ['SGSI ISO 27001','Evaluacion Riesgos','Auditoria Pentest','Capacitacion','Due Diligence Terceros','Plan Continuidad','Monitoreo SOC 24x7','Delegado Ciberseguridad'] },
  { n: 'NCG 538 (Regulacion CMF)',            ley: { 'NCG': 'exige', '21.719': 'satisface' },  ctrls: ['MFA Autenticacion','Cifrado AES / TLS'] },
  { n: 'BOD 26-04 (Gest. Vulnerabilidades)',  ley: { '21.663': 'satisface' },                  ctrls: ['Reporte Incidentes','Auditoria Pentest','Canal Disclosure'] },
  { n: 'Reporte y Notificacion',              ley: { '21.663': 'exige', '21.719': 'exige' },   ctrls: ['Reporte Incidentes','Canal Disclosure'] },
  { n: 'Modelo de Prevencion de Delitos (Ley 20.393)', ley: { '21.595': 'exige' },              ctrls: ['Encargado de Prevencion','Matriz Riesgo Penal','Protocolos Prevencion','Canal Denuncias','Evaluacion Independiente'] },
];
// Controles unicos en orden de primera aparicion
const CTRL = (() => { const seen = {}; const out = []; STD.forEach(s => s.ctrls.forEach(c => { if (!seen[c]) { seen[c] = 1; out.push(c); } })); return out; })();
// Conteo de estandares que comparten cada control (transversal = >=2)
const ctrlCount = {};
STD.forEach(s => s.ctrls.forEach(c => { ctrlCount[c] = (ctrlCount[c] || 0) + 1; }));
// Estandar OBLIGATORIO = al menos una ley lo 'exige'
const obligStd = {};
STD.forEach(s => { obligStd[s.n] = Object.values(s.ley).indexOf('exige') >= 0; });

// --- Aristas Ley->Est (rel exige/satisface) ---
const LK_LE = [];
STD.forEach(s => { for (const law in s.ley) {
  const rel = s.ley[law];
  LK_LE.push({ s: law, t: s.n, rel });
}});
// --- Aristas Est->Ctrl (trans/oblig) ---
const LK_EC = [];
STD.forEach(s => { s.ctrls.forEach(c => {
  const isTrans = ctrlCount[c] >= 2;
  LK_EC.push({ s: s.n, t: c, trans: isTrans, oblig: obligStd[s.n] });
}); });

// --- Layout: 3 columnas ---
const W = 1500, H = 900, PAD = 60;
const xL = 140, xC = 680, xR = 1330;      // centros de columna
const pillW = (name) => name.length * 10 + 34;   // mas ancha para fuente mas grande/bold
const usable = H - 2 * PAD;
const colY = (n) => { const step = usable / n; return Array.from({ length: n }, (_, i) => PAD + step * i + step / 2); };
const capH = (n, cap) => Math.min(usable / n - 6, cap);
const yL = colY(LEYES.length), yC = colY(STD.length), yR = colY(CTRL.length);
const hL = capH(LEYES.length, 56), hC = capH(STD.length, 84), hR = capH(CTRL.length, 30);

const idOf = (c) => 'body-' + c.replace('#', '');
const leyW = {}, stdW = {}, ctrlW = {};
LEYES.forEach((d, i) => leyW[d.code] = pillW(d.label));
STD.forEach((d, i) => stdW[d.n] = pillW(d.n));
CTRL.forEach((d, i) => ctrlW[d] = pillW(d));

const GAP = 4;
const edgePath = (x1, y1, x2, y2) => {
  const dx = (x2 - x1) * 0.45;
  return `M ${x1} ${y1} C ${x1 + dx} ${y1}, ${x2 - dx} ${y2}, ${x2} ${y2}`;
};

// Color/grosor/patron por semantica (replica hover/filtro del canonico, estatico)
function styleOfLE(rel) {
  if (rel === 'exige') return { c: '#E01111', w: 4, dash: null, op: 0.9 };
  return { c: '#1E6FD9', w: 2.5, dash: '7 6', op: 0.5 };
}
function styleOfEC(trans, oblig) {
  if (trans) return { c: '#9AA0A6', w: 2.5, dash: '7 6', op: 0.55 };
  if (oblig) return { c: '#E01111', w: 2, dash: null, op: 0.45 };
  return { c: '#9AA0A6', w: 2, dash: '7 6', op: 0.45 };
}

let paths = '';
const pushEdge = (x1, y1, x2, y2, st) => {
  const d = edgePath(x1, y1, x2, y2);
  const dur = (5.8 + Math.random() * 1.6).toFixed(2);
  const del = (-Math.random() * 4).toFixed(2);
  // ribbon base = trazo estatico con el patron semantico (solido o punteado) real
  paths += `<path class="ribbon" d="${d}" stroke="${st.c}" stroke-dasharray="${st.dash || ''}" opacity="${st.op}" stroke-width="${st.w}"></path>`;
  // glow = luz que fluye suave (lento) sobre todas las aristas (loop seamless)
  paths += `<path class="glow" d="${d}" stroke="${st.c}" stroke-width="${st.w + 1.2}" stroke-dasharray="240 9960" style="animation-duration:${dur}s;animation-delay:${del}s"></path>`;
};

// Leyes -> Estandares
LK_LE.forEach(e => {
  const li = LEYES.findIndex(l => l.code === e.s);
  const si = STD.findIndex(s => s.n === e.t);
  const st = styleOfLE(e.rel);
  const x1 = xL + leyW[e.s] / 2 + GAP, x2 = xC - stdW[e.t] / 2 - GAP;
  pushEdge(x1, yL[li], x2, yC[si], st);
});
// Estandares -> Controles
LK_EC.forEach(e => {
  const si = STD.findIndex(s => s.n === e.s);
  const ci = CTRL.indexOf(e.t);
  const st = styleOfEC(e.trans, e.oblig);
  const x1 = xC + stdW[e.s] / 2 + GAP, x2 = xR - ctrlW[e.t] / 2 - GAP;
  pushEdge(x1, yC[si], x2, yR[ci], st);
});

// --- Nodos: cada pill es una tarjeta GLASS independiente de su color (sin animacion) ---
const glassOf = (n, w, cx, cy, hEc, rxV, dark) => {
  const x = cx - w / 2, y = cy - hEc / 2;
  return `<g class="node">
  <rect class="halo" x="${x - 3}" y="${y - 3}" width="${w + 6}" height="${hEc + 6}" rx="${rxV + 2}" fill="${n.c}" opacity="0.4" filter="url(#blur)"/>
  <rect class="glass-body" x="${x}" y="${y}" width="${w}" height="${hEc}" rx="${rxV}" fill="url(#${idOf(n.c)})"/>
  <rect class="glass-sheen" x="${x}" y="${y}" width="${w}" height="${hEc}" rx="${rxV}" fill="url(#sheen)"/>
  <rect class="glass-border" x="${x}" y="${y}" width="${w}" height="${hEc}" rx="${rxV}" fill="none" stroke="${n.c}" stroke-opacity="0.4"/>
  <rect class="glass-stroke" x="${x}" y="${y}" width="${w}" height="${hEc}" rx="${rxV}" fill="none" stroke="${dark ? 'rgba(255,255,255,0.35)' : 'rgba(255,255,255,0.5)'}" stroke-opacity="0.6"/>
  <text x="${cx}" y="${cy}" class="lbl ${dark ? 'lbl-dark' : ''}">${n.text}</text>
  </g>`;
};
let blocks = '';
LEYES.forEach((d, i) => {
  blocks += glassOf({ c: d.color, text: d.label }, pillW(d.label), xL, yL[i], hL, 14);
});
STD.forEach((d, i) => {
  blocks += glassOf({ c: '#7FA8DC', text: d.n }, pillW(d.n), xC, yC[i], hC, 14, true);
});
CTRL.forEach((d, i) => {
  blocks += glassOf({ c: '#28A745', text: d }, pillW(d), xR, yR[i], hR, 10);
});

const allColors = [...new Set([...LEYES.map(l => l.color), '#7FA8DC', '#28A745'])];
const defs = `
<filter id="blur" x="-40%" y="-40%" width="180%" height="180%"><feGaussianBlur stdDeviation="5"/></filter>
<linearGradient id="sheen" x1="0" y1="0" x2="0" y2="1">
  <stop offset="0" stop-color="#ffffff" stop-opacity="0.45"/>
  <stop offset="0.5" stop-color="#ffffff" stop-opacity="0.05"/>
  <stop offset="1" stop-color="#ffffff" stop-opacity="0.14"/>
</linearGradient>
${allColors.map(c => `<linearGradient id="${idOf(c)}" x1="0" y1="0" x2="0" y2="1">
  <stop offset="0" stop-color="${c}" stop-opacity="0.28"/>
  <stop offset="1" stop-color="${c}" stop-opacity="0.10"/>
</linearGradient>`).join('\n')}`;

const svgMarkup = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" style="width:100%;height:100%;display:block;background:linear-gradient(180deg,#fafaf8 0%,#f3f1ec 100%)">
<style>
  .ribbon{fill:none;stroke-linecap:round}
  .glow{fill:none;stroke-linecap:round;opacity:0.88;animation-name:travel;animation-timing-function:linear;animation-iteration-count:infinite;will-change:stroke-dashoffset}
  @keyframes travel{to{stroke-dashoffset:-10200}}
  .halo{opacity:0.4;animation:halopulse 8s ease-in-out infinite;will-change:opacity}
  @keyframes halopulse{0%,100%{opacity:0.26}50%{opacity:0.5}}
  .glass-body{opacity:0.95}
  .glass-sheen{opacity:1}
  .glass-border{stroke-width:1.4}
  .glass-stroke{stroke-width:0.8}
  .lbl{font-size:16px;font-weight:600;fill:#1B1A1A;text-anchor:middle;dominant-baseline:middle;mix-blend-mode:multiply;opacity:0.95;letter-spacing:0.01em}
  .lbl-dark{fill:#063A6E;mix-blend-mode:normal;font-weight:700;text-shadow:0 0 3px rgba(255,255,255,0.25)}
</style>
<defs>${defs}</defs>
${paths}
${blocks}
</svg>`;
---

<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Convergencia Normativa — Chile 2026 (Sankey ligero)</title>
<style>
  *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
  html,body{height:100%}
  body{background:#fff;font-family:Segoe UI,Inter,Arial,sans-serif;color:#1B1A1A;display:flex;align-items:stretch;justify-content:center;margin:0}
</style>
</head>
<body set:html={svgMarkup}>
</body>
</html>
