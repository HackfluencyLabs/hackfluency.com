var nd=[{name:"SGSI ISO 27001",itemStyle:{color:"#1A1A18"}},{name:"MFA Autenticacion",itemStyle:{color:"#1A1A18"}},{name:"Reporte Incidentes",itemStyle:{color:"#1A1A18"}},{name:"Delegado Ciberseguridad",itemStyle:{color:"#1A1A18"}},{name:"Plan Continuidad",itemStyle:{color:"#1A1A18"}},{name:"Cifrado AES / TLS",itemStyle:{color:"#1A1A18"}},{name:"Auditoria Pentest",itemStyle:{color:"#1A1A18"}},{name:"Capacitacion",itemStyle:{color:"#1A1A18"}},{name:"Evaluacion Riesgos",itemStyle:{color:"#1A1A18"}},{name:"Monitoreo SOC 24x7",itemStyle:{color:"#1A1A18"}},{name:"Canal Disclosure",itemStyle:{color:"#1A1A18"}},{name:"Due Diligence Terceros",itemStyle:{color:"#1A1A18"}},{name:"SGSI Continuo",itemStyle:{color:"#DC3545"}},{name:"Registro SGSI",itemStyle:{color:"#DC3545"}},{name:"Plan Continuidad OIV",itemStyle:{color:"#DC3545"}},{name:"Monitoreo Continuo",itemStyle:{color:"#DC3545"}},{name:"Reduccion Impacto",itemStyle:{color:"#DC3545"}},{name:"Certificaciones",itemStyle:{color:"#DC3545"}},{name:"Reporte 3h 72h 15d",itemStyle:{color:"#DC3545"}},{name:"Delegado Ciberseguridad OIV",itemStyle:{color:"#DC3545"}},{name:"Capacitacion OIV",itemStyle:{color:"#DC3545"}},{name:"Informar Afectados",itemStyle:{color:"#DC3545"}},{name:"Notificar Brechas APDP",itemStyle:{color:"#5B6ABF"}},{name:"Seguridad Datos Cifrado",itemStyle:{color:"#5B6ABF"}},{name:"DPO Designacion",itemStyle:{color:"#5B6ABF"}},{name:"Eval Impacto DPIA",itemStyle:{color:"#5B6ABF"}},{name:"Resiliencia Sistemas",itemStyle:{color:"#5B6ABF"}},{name:"Responsabilidad Penal Directores",itemStyle:{color:"#6F42C1"}},{name:"Modelo Prevencion Delitos",itemStyle:{color:"#6F42C1"}},{name:"Autenticacion Reforzada CMF",itemStyle:{color:"#E67E22"}},{name:"Priorizacion Dinamica BOD",itemStyle:{color:"#28A745"}}];
var lk=[{source:"SGSI ISO 27001",target:"SGSI Continuo",value:1,art:"Ley 21.663 Art.8(a): SGSI continuo"},{source:"SGSI ISO 27001",target:"Registro SGSI",value:1,art:"Ley 21.663 Art.8(b): Registro acciones SGSI"},{source:"SGSI ISO 27001",target:"Plan Continuidad OIV",value:1,art:"Ley 21.663 Art.8(c): Planes continuidad certificados"},{source:"SGSI ISO 27001",target:"Monitoreo Continuo",value:1,art:"Ley 21.663 Art.8(d): Revision y simulacros"},{source:"SGSI ISO 27001",target:"Certificaciones",value:1,art:"Ley 21.663 Art.8(f) + Art.28"},{source:"SGSI ISO 27001",target:"Seguridad Datos Cifrado",value:1,art:"Ley 21.719 Art.14 quin.(a): Cifrado"},{source:"SGSI ISO 27001",target:"Resiliencia Sistemas",value:1,art:"Ley 21.719 Art.14 quin.(b-c)"},{source:"SGSI ISO 27001",target:"Eval Impacto DPIA",value:1,art:"Ley 21.719 Art.14 quin.(d)"},{source:"SGSI ISO 27001",target:"Modelo Prevencion Delitos",value:1,art:"Ley 21.595"},{source:"SGSI ISO 27001",target:"Priorizacion Dinamica BOD",value:1,art:"BOD 26-04"},{source:"MFA Autenticacion",target:"Autenticacion Reforzada CMF",value:1,art:"NCG 538 CMF"},{source:"MFA Autenticacion",target:"Seguridad Datos Cifrado",value:1,art:"Ley 21.719 Art.14 quin."},{source:"MFA Autenticacion",target:"Resiliencia Sistemas",value:1,art:"Ley 21.719 Art.14 quin.(b)"},{source:"Reporte Incidentes",target:"Reporte 3h 72h 15d",value:1,art:"Ley 21.663 Art.9"},{source:"Reporte Incidentes",target:"Notificar Brechas APDP",value:1,art:"Ley 21.719 Art.14 sexies"},{source:"Reporte Incidentes",target:"Priorizacion Dinamica BOD",value:1,art:"BOD 26-04"},{source:"Reporte Incidentes",target:"Responsabilidad Penal Directores",value:1,art:"Ley 21.595"},{source:"Delegado Ciberseguridad",target:"Delegado Ciberseguridad OIV",value:1,art:"Ley 21.663 Art.8(i)"},{source:"Delegado Ciberseguridad",target:"DPO Designacion",value:1,art:"Ley 21.719 DPO"},{source:"Delegado Ciberseguridad",target:"Responsabilidad Penal Directores",value:1,art:"Ley 21.595"},{source:"Plan Continuidad",target:"Plan Continuidad OIV",value:1,art:"Ley 21.663 Art.8(c)"},{source:"Plan Continuidad",target:"Resiliencia Sistemas",value:1,art:"Ley 21.719 Art.14 quin.(c)"},{source:"Cifrado AES / TLS",target:"Seguridad Datos Cifrado",value:1,art:"Ley 21.719 Art.14 quin."},{source:"Cifrado AES / TLS",target:"Autenticacion Reforzada CMF",value:1,art:"NCG 538 CMF"},{source:"Auditoria Pentest",target:"Reduccion Impacto",value:1,art:"Ley 21.663 Art.8(e)"},{source:"Auditoria Pentest",target:"Seguridad Datos Cifrado",value:1,art:"Ley 21.719 Art.14 quin."},{source:"Capacitacion",target:"Capacitacion OIV",value:1,art:"Ley 21.663 Art.8(h)"},{source:"Capacitacion",target:"Seguridad Datos Cifrado",value:1,art:"Ley 21.719 Art.14 quin."},{source:"Evaluacion Riesgos",target:"Monitoreo Continuo",value:1,art:"Ley 21.663 Art.8(d)"},{source:"Evaluacion Riesgos",target:"Eval Impacto DPIA",value:1,art:"Ley 21.719 Art.14 quin.(d)"},{source:"Monitoreo SOC 24x7",target:"Monitoreo Continuo",value:1,art:"Ley 21.663 Art.8(d)"},{source:"Monitoreo SOC 24x7",target:"Priorizacion Dinamica BOD",value:1,art:"BOD 26-04"},{source:"Canal Disclosure",target:"Reporte 3h 72h 15d",value:1,art:"Ley 21.663 Art.9"},{source:"Due Diligence Terceros",target:"Reduccion Impacto",value:1,art:"Ley 21.663 Art.8(e)"},{source:"Due Diligence Terceros",target:"Modelo Prevencion Delitos",value:1,art:"Ley 21.595"}];
var out={},inc={};
lk.forEach(function(x){out[x.source]=(out[x.source]||0)+1;inc[x.target]=(inc[x.target]||0)+1;});
var c1=echarts.init(document.getElementById('chart-sankey'));
var artMap={};
for(var ai=0;ai<lk.length;ai++){artMap[lk[ai].source+'|||'+lk[ai].target]=lk[ai].art;}
c1.setOption({
tooltip:{trigger:'item',formatter:function(p){
if(p.dataType==='edge'){var key=p.data.source+'|||'+p.data.target;var a=artMap[key]||'-';return'<b>'+p.data.source+'</b> -> <b>'+p.data.target+'</b><br/><span style=color:#155724;font-size:12px>'+a+'</span>';}
return'<b>'+p.name+'</b><br/><span style=color:#6C757D;font-size:12px>'+(out[p.name]||0)+' conexiones salientes | '+(inc[p.name]||0)+' conexiones entrantes';}},
series:[{type:'sankey',layout:'force',nodeWidth:12,nodeGap:6,draggable:true, left:'4%',right:'16%',bottom:14,top:14,
emphasis:{focus:'adjacency',lineStyle:{width:4,opacity:0.95,color:'#fff'}},
blur:{lineStyle:{opacity:0.04}},
label:{fontSize:11,fontWeight:'bold',color:'#1A1A18'},
animationDuration:700,animationEasing:'linear',animationDelay:0,
lineStyle:{color:'gradient',curveness:0.5,opacity:0.08},
data:nd,links:lk}]});
setTimeout(function(){document.getElementById('sankey-overlay').style.opacity='0';},80);
// Neon flow animation
var flowPhase=0,flowActive=true,flowPaused=false,flowFrame=0;
function animateFlow(){
if(!flowActive)return;
flowPhase+=0.00035;flowFrame++;
if(!flowPaused && flowFrame%4===0){
var len=lk.length;var newLinks=[];
for(var i=0;i<len;i++){
var pos=i/len,ph=pos-flowPhase,dx=ph-Math.round(ph),dist=Math.max(0,1-Math.abs(dx)*3),pulse=dist*dist*0.65,wave=Math.sin(ph*Math.PI*4)*0.5+0.5;
newLinks.push({source:lk[i].source,target:lk[i].target,value:lk[i].value,lineStyle:{opacity:0.04+pulse+wave*0.18,curveness:0.35+Math.sin(ph*Math.PI*3+lk[i].source.length)*0.25}});}
c1.setOption({series:[{animationDuration:0,links:newLinks,emphasis:{focus:'adjacency',lineStyle:{width:4,opacity:0.95,color:'#fff'}},blur:{lineStyle:{opacity:0.03}}}]});}
requestAnimationFrame(animateFlow);}
c1.on('mouseover',function(p){if(p.componentType==='series' && Object.keys(activeLaws).length===0)flowPaused=true;});
c1.on('mouseout',function(p){if(p.componentType==='series' && Object.keys(activeLaws).length===0)flowPaused=false;});
setTimeout(function(){if(flowActive)animateFlow();},50);
window.addEventListener('resize',function(){c1.resize();});
var activeLaws={};window.toggleLawFilter=function(law){
var btns=document.querySelectorAll('#lawFilters .lawFilter');
if(activeLaws[law]){delete activeLaws[law];}else{activeLaws[law]=true;}
var anyActive=Object.keys(activeLaws).length>0;flowPaused=anyActive;
btns.forEach(function(e){var l=e.getAttribute('data-law'),isActive=!!activeLaws[l];e.style.borderColor=isActive?'#1A1A18':'transparent';e.style.background=isActive?'rgba(0,0,0,0.05)':'transparent';});
if(!anyActive)return;
var filtered=[];
for(var fi=0;fi<lk.length;fi++){
var art=lk[fi].art||'',match=false;
for(var l in activeLaws){if(art.indexOf(l)>=0){match=true;break;}}
filtered.push({source:lk[fi].source,target:lk[fi].target,value:lk[fi].value,lineStyle:{opacity:match?0.55:0.03,curveness:match?0.45:0.35}});}
c1.setOption({series:[{links:filtered,emphasis:{focus:'adjacency',lineStyle:{width:3,opacity:0.9}},blur:{lineStyle:{opacity:0.02}}}]});}
})();
</script>
