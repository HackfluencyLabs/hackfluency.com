<style>
  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    padding: 120px 0 80px;
    overflow: hidden;
    border-bottom: 1px solid var(--hf-border);
    background: var(--hf-bg);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: 
      linear-gradient(30deg, var(--hf-border) 1px, transparent 1px),
      linear-gradient(150deg, var(--hf-border) 1px, transparent 1px);
    background-size: 40px 69.28px;
    opacity: 0.1;
    pointer-events: none;
  }

  .hero-abstract {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.15;
    mix-blend-mode: screen;
  }

  @media (max-width: 767px) {
    .hero-abstract { opacity: 0.08; }
  }

  .hero-abstract-svg {
    width: 100%;
    height: 100%;
  }

  .abs-ring {
    fill: none;
    stroke-width: 0.8;
    opacity: 0.6;
  }
  .abs-ring--human { stroke: var(--hf-accent-human, #9C5E4D); }
  .abs-ring--privacy { stroke: var(--hf-accent-privacy, #1E3A5F); }
  .abs-ring--analysis { stroke: var(--hf-accent-analysis, #6C4F9E); }
  .abs-ring--philosophy { stroke: var(--hf-accent-philosophy, #7A6A4E); }

  .abs-strand {
    stroke: var(--hf-text);
    stroke-width: 0.5;
    opacity: 0.12;
    stroke-dasharray: 3 6;
  }
  .abs-strand--dim { opacity: 0.06; }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    width: 100%;
    padding-bottom: 80px;
  }

  @media (min-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr 1fr;
      text-align: left;
      gap: 64px;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media (max-width: 1023px) {
    .hero-text {
      align-items: center;
      text-align: center;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--hf-accent-dim);
    border: 1px solid var(--hf-accent-border);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--primary);
    margin-bottom: 28px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .hero-title-accent {
    color: var(--hf-accent);
    font-family: 'Source Serif 4', 'Georgia', serif;
    font-weight: 600;
    font-style: italic;
    display: block;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--gray-400);
    max-width: 540px;
    margin: 0 0 40px;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 0;
  }

  @media (max-width: 1023px) {
    .hero-actions {
      justify-content: center;
    }
  }

  .hero-proof {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding: 13px 18px;
    border: 1px solid color-mix(in srgb, var(--hf-text) 12%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--hf-text) 4%, transparent);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .hero-proof:hover {
    border-color: color-mix(in srgb, var(--hf-text) 22%, transparent);
    background: color-mix(in srgb, var(--hf-text) 7%, transparent);
  }

  @media (max-width: 1023px) {
    .hero-proof {
      width: 100%;
      max-width: 360px;
    }
  }

  .hero-proof-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hf-accent-border);
    border-radius: 9px;
    background: var(--hf-accent-dim);
  }

  .hero-proof-icon svg {
    width: 18px;
    height: 18px;
    stroke: var(--primary);
  }

  .hero-proof-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-proof-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--primary);
    opacity: 0.75;
  }

  .hero-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--white);
    transition: color 0.2s ease;
  }

  .hero-proof:hover .hero-proof-link {
    color: var(--primary);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    min-height: 48px;
    min-width: 48px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    overflow: hidden;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 50%);
    pointer-events: none;
    border-radius: inherit;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--hf-accent) 0%, color-mix(in srgb, var(--hf-accent) 80%, #000) 100%);
    color: #ffffff;
    box-shadow: 0 4px 20px color-mix(in srgb, var(--hf-accent) 35%, transparent);
  }

  .btn-primary span,
  .btn-primary svg {
    position: relative;
    z-index: 1;
  }

  .btn-primary span {
    color: #ffffff;
    font-weight: 700;
  }

  .btn-primary svg {
    stroke: var(--hf-bg);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--hf-accent) 45%, transparent);
    color: #ffffff;
  }

  .btn-secondary {
    background: transparent;
    color: var(--white);
    border: 1px solid color-mix(in srgb, var(--hf-text) 20%, transparent);
    backdrop-filter: blur(4px);
  }

  .btn-secondary:hover {
    background: color-mix(in srgb, var(--hf-text) 6%, transparent);
    border-color: color-mix(in srgb, var(--hf-text) 35%, transparent);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: color-mix(in srgb, var(--hf-text) 4%, transparent);
    color: var(--gray-300);
    border: 1px solid color-mix(in srgb, var(--hf-text) 10%, transparent);
    font-size: 0.95rem;
    backdrop-filter: blur(4px);
  }

  .btn-ghost:hover {
    color: var(--hf-accent);
    border-color: color-mix(in srgb, var(--hf-accent) 40%, transparent);
    background: color-mix(in srgb, var(--hf-accent) 8%, transparent);
    transform: translateY(-2px);
  }

  .btn-large {
    padding: 20px 48px;
    font-size: 1.1rem;
  }

  .btn-full {
    width: 100%;
  }

  /* Architecture diagram */
  .hero-diagram {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .arch-diagram {
    width: 100%;
    max-width: 420px;
    height: auto;
  }

  .arch-line {
    stroke: var(--hf-accent);
    stroke-width: 1.5;
    opacity: 0.35;
  }

  .arch-line--dim {
    opacity: 0.18;
    stroke-dasharray: 4 4;
  }
  .arch-line--cross {
    opacity: 0.12;
    stroke-dasharray: 2 8;
    stroke-width: 1;
  }

  .arch-node {
    fill: none;
    stroke: var(--hf-accent);
    stroke-width: 1.5;
    opacity: 0.5;
  }

  .arch-node--primary {
    opacity: 0.8;
    stroke-width: 2;
  }

  .arch-node--secondary {
    opacity: 0.6;
  }

  .arch-node--organic {
    stroke: var(--hf-accent-human);
    opacity: 0.6;
  }

  .arch-node--abstract {
    stroke: var(--hf-accent-philosophy);
    opacity: 0.5;
  }

  .arch-node--tertiary {
    opacity: 0.4;
  }

  .arch-node-inner {
    fill: var(--hf-accent);
    stroke: none;
    opacity: 0.12;
  }

  .arch-pulse {
    fill: none;
    stroke: var(--hf-accent);
    stroke-width: 1;
    opacity: 0;
    animation: archPulse 3s ease-out infinite;
  }

  .arch-pulse--delay1 {
    animation-delay: 1s;
  }

  .arch-pulse--delay2 {
    animation-delay: 2s;
  }

  .arch-pulse--organic {
    stroke: var(--hf-accent-human);
  }

  @keyframes archPulse {
    0% { opacity: 0.6; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.15); }
  }

  .arch-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    fill: var(--hf-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Sections */
  section {
    padding: 120px 0;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 80px;
  }

  .section-tag {
    display: inline-block;
    padding: 6px 18px;
    background: linear-gradient(135deg, var(--hf-accent-dim) 0%, color-mix(in srgb, var(--hf-accent) 5%, transparent) 100%);
    border: 1px solid color-mix(in srgb, var(--hf-accent) 20%, transparent);
    border-radius: 100px;
    font-size: 0.78rem;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 20px;
    font-weight: 600;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 20px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--gray-400);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }



  /* Tool CTA Banner */
  .tool-cta { padding: 0 0 60px; }
  .tool-cta-card { display:flex; align-items:center; gap:20px; background:var(--hf-accent-dim); border:1px solid var(--hf-accent-border); border-radius:12px; padding:20px 24px; flex-wrap:wrap; }
  .tool-cta-badge { font-size:0.65rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--hf-accent); background:var(--hf-bg-card); border:1px solid var(--hf-accent-border); border-radius:100px; padding:3px 10px; white-space:nowrap; flex-shrink:0; }
  .tool-cta-body { display:flex; align-items:center; gap:14px; flex:1; min-width:200px; }
  .tool-cta-icon { width:36px; height:36px; color:var(--hf-accent); flex-shrink:0; }
  .tool-cta-title { font-family:'JetBrains Mono',monospace; font-size:0.82rem; font-weight:700; color:var(--hf-text); margin-bottom:1px; }
  .tool-cta-desc { font-size:0.78rem; color:var(--hf-text-secondary); line-height:1.4; }
  .tool-cta-btn { display:inline-flex; align-items:center; gap:6px; font-size:0.82rem; font-weight:600; color:var(--hf-text-muted); background:var(--hf-bg-card); border:1px solid var(--hf-border); border-radius:8px; padding:9px 18px; text-decoration:none; transition:all 0.2s; white-space:nowrap; flex-shrink:0; }
  .tool-cta-btn:hover { border-color:var(--hf-accent); color:var(--hf-accent); }
    @media (max-width:640px) { .tool-cta-card { flex-direction:column; text-align:center; } .tool-cta-body { flex-direction:column; text-align:center; } .tool-cta-btn { width:100%; } }

  /* Services */
  .services {
    background: var(--dark);
  }

  /* ── Services Chronograph (High-End Precision) ── */
  .services-chronograph {
    max-width: 1100px;
    margin: 20px auto 40px; /* Reduced vertical margins */
    padding: 0 24px;
    position: relative;
  }

  /* Connecting Aristas Style */
  .chrono-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.15;
    pointer-events: none;
  }

  html[data-theme-mode="light"] .chrono-mesh {
    opacity: 0.5; /* Increased container visibility for light themes */
  }
  
  .chrono-mesh svg { width: 100%; height: 100%; }
  
  .mesh-line {
    stroke: var(--hf-accent);
    stroke-width: 1;
    fill: none;
    stroke-dasharray: 4 4;
    animation: meshFlow 20s linear infinite;
  }

  html[data-theme-mode="light"] .mesh-line {
    stroke: var(--hf-text-muted); /* High contrast gray for white backgrounds */
    stroke-width: 1.2;
  }

  .mesh-line--alt {
    stroke: var(--hf-accent-human, #9C5E4D);
    opacity: 0.5;
    animation-duration: 30s;
    animation-direction: reverse;
  }

  html[data-theme-mode="light"] .mesh-line--alt {
    stroke: var(--hf-accent-human);
    stroke-width: 1;
  }

  @keyframes meshFlow {
    from { stroke-dashoffset: 200; }
    to { stroke-dashoffset: 0; }
  }

  .chronograph-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .chronograph-grid { grid-template-columns: repeat(4, 1fr); gap: 40px 20px; }
  }

  /* Section Padding Reductions */
  section {
    padding: 80px 0; /* Reduced from 120px */
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px; /* Reduced from 80px */
  }

  .services {
    background: var(--dark);
    padding-bottom: 40px; /* Tighten bottom */
  }

  .about {
    position: relative;
    background: var(--hf-bg-secondary);
    border-bottom: 1px solid var(--hf-border);
    padding-top: 60px; /* Reduced to bring closer to services */
  }

  .chronograph-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  @media (min-width: 768px) {
    .chronograph-grid { grid-template-columns: repeat(4, 1fr); gap: 40px; }
  }

  .chrono-node {
    position: relative;
    aspect-ratio: 1;
    animation: chronoFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--delay);
  }

  @keyframes chronoFadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chrono-unit {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: crosshair;
    position: relative;
  }

  .chrono-cat-badge {
    position: absolute;
    top: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cat-color);
    opacity: 0.5;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Precision Rims */
  .chrono-rim-outer,
  .chrono-rim-inner {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 0.5px solid color-mix(in srgb, var(--chrono-color) 20%, var(--hf-border));
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chrono-rim-outer {
    border-style: dashed;
    border-width: 1px;
    animation: chronoRotate 60s linear infinite;
  }

  .chrono-rim-inner {
    inset: 15%;
    border-style: solid;
    opacity: 0.3;
    animation: chronoRotate 40s linear infinite reverse;
  }

  .chrono-unit:hover .chrono-rim-outer {
    inset: -10px;
    border-color: var(--chrono-color);
    border-style: solid;
    opacity: 0.6;
    animation-duration: 10s;
  }

  .chrono-unit:hover .chrono-rim-inner {
    inset: 10%;
    opacity: 0.8;
    border-color: var(--chrono-color);
    animation-duration: 5s;
  }

  @keyframes chronoRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .chrono-content {
    position: relative;
    z-index: 5;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .chrono-icon {
    width: 32px;
    height: 32px;
    color: var(--chrono-color);
    transition: all 0.4s ease;
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--chrono-color) 30%, transparent));
  }

  .chrono-title {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--hf-text-secondary);
    max-width: 125px;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .chrono-unit:hover .chrono-title {
    color: var(--hf-text);
  }

  /* ── Technical Spec Sheet (Tooltip) ── */
  .chrono-spec {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 300px;
    padding: 24px;
    background: color-mix(in srgb, var(--hf-bg-elevated) 98%, #fff);
    backdrop-filter: blur(20px);
    border: 1px solid var(--hf-border);
    box-shadow: 0 30px 60px rgba(0,0,0,0.6);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -40%) scale(0.95);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 100;
    pointer-events: none;
  }

  @media (hover: hover) {
    .chrono-unit:hover .chrono-spec {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, -50%) scale(1);
      pointer-events: auto;
    }
  }
  .chrono-unit.active .chrono-spec {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
  }

  .spec-header {
    margin-bottom: 16px;
    border-bottom: 1px solid var(--hf-border);
    padding-bottom: 12px;
  }

  .spec-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    color: var(--chrono-color);
    display: block;
    margin-bottom: 4px;
    letter-spacing: 0.1em;
  }

  .spec-header h4 {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--hf-text);
  }

  .chrono-spec p {
    font-size: 0.85rem;
    color: var(--gray-400);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .spec-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--hf-accent);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: inline-block;
    border-bottom: 1px solid transparent;
    transition: all 0.3s;
  }

  .spec-link:hover {
    color: var(--hf-accent-light);
    border-bottom-color: var(--hf-accent);
  }

  @media (max-width: 767px) {
    .chrono-node {
      animation: none;
    }
    .chrono-spec {
      position: fixed;
      left: 16px;
      right: 16px;
      bottom: 16px;
      top: auto;
      width: auto;
      padding: 16px;
      border-radius: 12px;
      max-height: 40vh;
      overflow-y: auto;
      transform: translateY(20px);
    }
    .chrono-spec p { font-size: 0.8rem; margin-bottom: 12px; }
    .spec-header { margin-bottom: 10px; padding-bottom: 8px; }
    .spec-header h4 { font-size: 0.8rem; }
    .spec-code { font-size: 0.55rem; }
    @media (hover: hover) {
      .chrono-unit:hover .chrono-spec { transform: translateY(0); }
    }
    .chrono-unit.active .chrono-spec { transform: translateY(0); }
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  /* ── Gear Card ── */
  .gear-card {
    position: relative;
    background: var(--hf-bg-card);
    border: 1px solid color-mix(in srgb, var(--gear-color, var(--hf-accent)) 20%, var(--hf-border));
    border-radius: 14px;
    padding: 28px 16px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: default;
    overflow: visible;
    animation: gearFadeIn 0.6s ease-out both;
    animation-delay: var(--delay, 0s);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  @keyframes gearFadeIn {
    from { opacity: 0; transform: translateY(20px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ── Gear teeth top & bottom ── */
  .gear-teeth-top,
  .gear-teeth-bottom {
    position: absolute;
    left: -1px;
    right: -1px;
    height: 8px;
    background: transparent;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
  }
  .gear-teeth-top {
    top: -5px;
  }
  .gear-teeth-bottom {
    bottom: -5px;
  }

  .gear-teeth-top::before,
  .gear-teeth-bottom::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 100%;
    background: repeating-radial-gradient(
      ellipse 6px 6px at 12px center,
      color-mix(in srgb, var(--gear-color, var(--hf-accent)) 40%, var(--hf-border)) 0px,
      color-mix(in srgb, var(--gear-color, var(--hf-accent)) 40%, var(--hf-border)) 5px,
      transparent 5px,
      transparent 10px
    );
    background-size: 24px 100%;
  }

  .gear-card:hover .gear-teeth-top::before,
  .gear-card:hover .gear-teeth-bottom::before {
    background: repeating-radial-gradient(
      ellipse 6px 6px at 12px center,
      var(--gear-color, var(--hf-accent)) 0px,
      var(--gear-color, var(--hf-accent)) 5px,
      transparent 5px,
      transparent 10px
    );
  }

  /* ── Rotor (gear SVG) ── */
  .gear-rotor {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  .gear-rotor svg {
    width: 85%;
    height: 85%;
    stroke: color-mix(in srgb, var(--gear-color, var(--hf-accent)) 8%, transparent);
    fill: none;
    animation: gearSpin var(--rot-speed, 6s) linear infinite;
  }

  .gear-card:hover .gear-rotor svg {
    stroke: color-mix(in srgb, var(--gear-color, var(--hf-accent)) 20%, transparent);
    animation-duration: calc(var(--rot-speed, 6s) * 0.3);
  }

  /* Each adjacent card rotates in opposite direction */
  .gear-card:nth-child(even) .gear-rotor svg {
    animation-direction: reverse;
  }

  @keyframes gearSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ── Icon ── */
  .gear-card-icon {
    position: relative;
    z-index: 1;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gear-color, var(--hf-accent));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gear-card-icon svg {
    width: 100%;
    height: 100%;
  }

  .gear-card:hover .gear-card-icon {
    transform: scale(1.15);
  }

  /* ── Title ── */
  .gear-card-title {
    position: relative;
    z-index: 1;
    font-size: 0.8rem;
    font-weight: 700;
    text-align: center;
    color: var(--hf-text);
    line-height: 1.25;
    letter-spacing: 0.02em;
  }

  /* ── Tooltip ── */
  .gear-card-tooltip {
    position: absolute;
    z-index: 50;
    bottom: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%) translateY(6px);
    width: 240px;
    padding: 14px 18px;
    background: var(--hf-bg-elevated);
    border: 1px solid color-mix(in srgb, var(--gear-color, var(--hf-accent)) 30%, var(--hf-border));
    border-radius: 10px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    opacity: 0;
    pointer-events: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gear-card-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: color-mix(in srgb, var(--gear-color, var(--hf-accent)) 30%, var(--hf-border));
  }

  .gear-card:hover .gear-card-tooltip {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .gear-card-desc {
    font-size: 0.8rem;
    color: var(--gray-300);
    line-height: 1.55;
    margin-bottom: 8px;
  }

  .gear-card-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--gear-color, var(--hf-accent));
    text-decoration: none;
    transition: gap 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .gear-card-link:hover {
    gap: 9px;
  }

  @media (max-width: 639px) {
    .services-grid { gap: 14px; }
    .gear-card { padding: 20px 12px 18px; }
    .gear-card-title { font-size: 0.72rem; }
    .gear-card-icon { width: 34px; height: 34px; }
    .gear-teeth-top, .gear-teeth-bottom { height: 6px; }
    .gear-teeth-top { top: -4px; }
    .gear-teeth-bottom { bottom: -4px; }
    .gear-card-tooltip { width: 200px; bottom: calc(100% + 10px); }
  }

  /* Member Grid */
  .member-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .member-card {
    flex: 0 0 220px;
    background: var(--hf-bg);
    border: 1px solid var(--hf-border);
    border-radius: 12px;
    padding: 32px 24px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .member-card:hover {
    border-color: color-mix(in srgb, var(--hf-accent) 40%, var(--hf-border));
    transform: translateY(-3px);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--hf-accent) 8%, transparent);
  }

  .member-avatar {
    width: 72px;
    height: 72px;
    margin: 0 auto 16px;
  }
  .member-photo-img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  .member-lenses {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 12px;
  }
  .m-lens {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 3px 8px 3px 6px;
    border-radius: 100px;
    border: 1px solid;
    background: color-mix(in srgb, var(--hf-bg) 50%, transparent);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: all 0.25s ease;
    position: relative;
  }
  .m-lens svg {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    opacity: 0.9;
  }
  .m-lens span {
    line-height: 1;
  }
  .member-card:hover .m-lens {
    transform: translateY(-1px);
    box-shadow: 0 0 8px color-mix(in srgb, currentColor 8%, transparent);
  }
  .m-lens--digital { color: var(--hf-accent); border-color: color-mix(in srgb, var(--hf-accent) 35%, transparent); background: linear-gradient(135deg, color-mix(in srgb, var(--hf-accent) 10%, var(--hf-bg)) 0%, color-mix(in srgb, var(--hf-accent) 3%, var(--hf-bg)) 100%); }
  .m-lens--human { color: var(--hf-accent-human); border-color: color-mix(in srgb, var(--hf-accent-human) 35%, transparent); background: linear-gradient(135deg, color-mix(in srgb, var(--hf-accent-human) 10%, var(--hf-bg)) 0%, color-mix(in srgb, var(--hf-accent-human) 3%, var(--hf-bg)) 100%); }
  .m-lens--social { color: var(--hf-accent-privacy); border-color: color-mix(in srgb, var(--hf-accent-privacy) 35%, transparent); background: linear-gradient(135deg, color-mix(in srgb, var(--hf-accent-privacy) 10%, var(--hf-bg)) 0%, color-mix(in srgb, var(--hf-accent-privacy) 3%, var(--hf-bg)) 100%); }
  .m-lens--philosophy { color: var(--hf-accent-philosophy); border-color: color-mix(in srgb, var(--hf-accent-philosophy) 35%, transparent); background: linear-gradient(135deg, color-mix(in srgb, var(--hf-accent-philosophy) 10%, var(--hf-bg)) 0%, color-mix(in srgb, var(--hf-accent-philosophy) 3%, var(--hf-bg)) 100%); }
  .m-lens--digital { color: var(--hf-accent); border-color: color-mix(in srgb, var(--hf-accent) 30%, transparent); }
  .m-lens--human { color: var(--hf-accent-human); border-color: color-mix(in srgb, var(--hf-accent-human) 30%, transparent); }
  .m-lens--social { color: var(--hf-accent-privacy); border-color: color-mix(in srgb, var(--hf-accent-privacy) 30%, transparent); }
  .m-lens--philosophy { color: var(--hf-accent-philosophy); border-color: color-mix(in srgb, var(--hf-accent-philosophy) 30%, transparent); }

  .member-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--hf-text);
    margin-bottom: 4px;
  }

  .member-role {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--hf-accent);
    margin-bottom: 10px;
  }

  .member-desc {
    font-size: 0.82rem;
    color: var(--gray-400);
    line-height: 1.5;
  }

  /* About */
  .about {
    position: relative;
    background: var(--hf-bg-secondary);
    border-bottom: 1px solid var(--hf-border);
  }

  .about::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(var(--hf-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--hf-border) 1px, transparent 1px);
    background-size: 60px 60px;
    opacity: 0.2;
    pointer-events: none;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 60px;
    align-items: center;
    position: relative;
  }

  @media (min-width: 1024px) {
    .about-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .about-text {
    color: var(--gray-400);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 20px;
  }

  .about-content .section-title {
    font-family: 'Source Serif 4', 'Georgia', serif;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .about-features {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 32px;
  }

  .about-feature {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--gray-300);
  }

  .about-feature svg {
    color: var(--hf-accent);
    flex-shrink: 0;
  }



  /* Partners Grid */
  .partners {
    background: var(--hf-bg);
    border-top: 1px solid var(--hf-border);
    border-bottom: 1px solid var(--hf-border);
    padding: 80px 0;
  }

  .partners-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 40px 60px;
    max-width: 900px;
    margin: 0 auto;
  }

  .partner-item {
    flex: 0 0 200px;
    text-align: center;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .partner-item:hover {
    opacity: 1;
  }

  .partner-item--placeholder {
    opacity: 0.4;
    cursor: default;
    pointer-events: none;
  }

  .partner-logo-img {
    width: 72px;
    height: 72px;
    object-fit: contain;
    border-radius: 12px;
  }

  .partner-item a {
    text-decoration: none;
  }

  .partner-icon {
    width: 72px;
    height: 72px;
    margin: 0 auto 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--hf-text);
    margin-bottom: 6px;
  }

  .partner-desc {
    font-size: 0.78rem;
    color: var(--gray-500);
    line-height: 1.5;
  }

  /* Values */
  .values {
    background: var(--dark);
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 640px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {
    .values-grid {
      grid-template-columns: repeat(3, 1fr);
      max-width: 900px;
      margin: 0 auto;
    }
  }

  .value-card {
    background: var(--hf-bg);
    border: 1px solid var(--hf-border);
    border-radius: 12px;
    padding: 48px 32px;
    text-align: center;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .value-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--hf-accent) 5%, transparent) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: inherit;
  }

  .value-card:hover::before {
    opacity: 1;
  }

  .value-card:hover {
    background: var(--hf-bg-secondary);
    border-color: color-mix(in srgb, var(--hf-accent) 40%, var(--hf-border));
    transform: translateY(-4px);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--hf-accent) 8%, transparent);
  }

  .value-card:hover .value-icon {
    background: var(--hf-accent);
    border-color: var(--hf-accent);
    color: var(--hf-bg);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--hf-accent) 25%, transparent);
  }

  .value-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hf-border);
    margin: 0 auto 32px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--hf-accent);
    border-radius: 16px;
  }

  .value-icon svg {
    width: 100%;
    height: 100%;
  }

  .value-title {
    font-size: 1.25rem;
    margin-bottom: 12px;
    color: var(--white);
  }

  .value-description {
    color: var(--gray-400);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  /* CTA */
  .cta {
    border-top: 1px solid var(--hf-border);
    border-bottom: 1px solid var(--hf-border);
    background: linear-gradient(135deg, var(--hf-bg-secondary) 0%, var(--hf-bg) 50%, var(--hf-bg-secondary) 100%);
    position: relative;
    padding: 100px 0;
  }

  .cta-glow {
    display: none;
  }

  .cta-content {
    position: relative;
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 20px;
  }

  .cta-subtitle {
    color: var(--gray-300);
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 32px;
  }

  .cta-features {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    margin-bottom: 40px;
  }

  .cta-feature {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--gray-400);
  }

  .cta-feature svg {
    color: var(--hf-accent);
    flex-shrink: 0;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    margin-bottom: 16px;
  }

  .cta-note {
    font-size: 0.8rem;
    color: var(--gray-600);
    font-style: italic;
  }

  /* Problem Form */
  .problem-form {
    max-width: 600px;
    margin: 0 auto 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .problem-form-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .problem-form-row input,
  .problem-form-row select,
  .problem-form-row textarea {
    flex: 1;
    min-width: 200px;
    padding: 14px 16px;
    background: var(--hf-bg);
    border: 1px solid var(--hf-border);
    border-radius: 10px;
    color: var(--hf-text);
    font-size: 0.9rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease;
    min-height: 48px;
  }

  .problem-form-row textarea {
    width: 100%;
    min-width: 100%;
    resize: vertical;
    min-height: 120px;
  }

  .problem-form-row input:focus,
  .problem-form-row select:focus,
  .problem-form-row textarea:focus {
    border-color: var(--hf-accent);
  }

  .problem-form-row input::placeholder,
  .problem-form-row textarea::placeholder {
    color: var(--gray-600);
  }

  .problem-form-row select {
    cursor: pointer;
    appearance: auto;
  }

  .problem-form-row select option {
    background: var(--hf-bg-secondary);
    color: var(--hf-text);
  }

  /* Footer */
  .footer {
    background: var(--hf-bg-secondary);
    border-top: 1px solid var(--hf-border);
    padding: 80px 0 40px;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr 2fr;
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-logo-img {
    width: 48px;
    height: 48px;
  }

  .footer-tagline {
    font-size: 0.85rem;
    color: var(--gray-500);
    line-height: 1.6;
    max-width: 300px;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 32px;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-column h5 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gray-600);
    margin-bottom: 8px;
  }

  .footer-column a {
    font-size: 0.85rem;
    color: var(--gray-400);
    transition: color 0.2s ease;
    padding: 4px 0;
  }

  .footer-column a:hover {
    color: var(--primary);
  }

  /* Newsletter */
  .newsletter-section {
    padding: 32px 0;
    border-top: 1px solid var(--hf-border);
    border-bottom: 1px solid var(--hf-border);
    margin-bottom: 32px;
    text-align: center;
  }

  .newsletter-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem;
    margin-bottom: 8px;
  }

  .newsletter-subtitle {
    font-size: 0.85rem;
    color: var(--gray-500);
    margin-bottom: 20px;
  }

  .subscribe-form {
    display: flex;
    gap: 12px;
    max-width: 420px;
    margin: 0 auto;
    flex-wrap: wrap;
    justify-content: center;
  }

  .subscribe-form input {
    flex: 1;
    min-width: 200px;
    padding: 12px 16px;
    background: var(--hf-bg);
    border: 1px solid var(--hf-border);
    border-radius: 8px;
    color: var(--hf-text);
    font-size: 0.9rem;
    min-height: 44px;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .subscribe-form input:focus {
    border-color: var(--hf-accent);
  }

  .subscribe-form input::placeholder {
    color: var(--gray-600);
  }

  .subscribe-btn {
    padding: 12px 24px;
    background: var(--hf-accent);
    color: var(--hf-text-on-accent);
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    min-height: 44px;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .subscribe-btn:hover {
    background: var(--hf-accent-light);
  }

  .form-message {
    width: 100%;
    font-size: 0.8rem;
    margin-top: 8px;
  }

  .form-message.error { color: var(--accent); }
  .form-message.success { color: var(--primary); }
  .form-message.warning { color: #f59e0b; }
  .form-message.info { color: var(--gray-400); }

  /* Trustpilot */
  .trustpilot-section {
    padding: 32px 0;
    text-align: center;
  }

  .trustpilot-inner {
    max-width: 500px;
    margin: 0 auto;
  }

  .trustpilot-header {
    margin-bottom: 20px;
  }

  .trustpilot-stars {
    display: flex;
    gap: 4px;
    justify-content: center;
    margin-bottom: 12px;
  }

  .trustpilot-stars svg {
    width: 28px;
    height: 28px;
    fill: #00b67a;
  }

  .trustpilot-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .trustpilot-sub {
    font-size: 0.8rem;
    color: var(--gray-500);
  }

  .trustpilot-widget {
    margin-top: 8px;
  }

  /* Footer bottom */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    font-size: 0.8rem;
    color: var(--gray-600);
  }

  .footer-email {
    color: var(--gray-400);
    transition: color 0.2s ease;
  }

  .footer-email:hover {
    color: var(--primary);
  }

  /* ── Paper Hero (Journal-style) ── */
  .paper-hero {
    position: relative;
    z-index: 1;
    padding: 40px 24px 20px;
  }
  .paper-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--hf-border, #222);
  }
  html[data-theme-mode="light"] .paper-head {
    border-bottom-color: #d0d8e0;
  }
  .paper-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .paper-ref { color: var(--hf-accent, #00D26A); }
  .paper-sep { color: var(--hf-text-dim, #444); opacity: 0.4; }
  .paper-date { color: var(--hf-text-muted, #888); }
  .paper-tag {
    color: var(--hf-accent, #00D26A);
    border: 1px solid var(--hf-accent-border, rgba(0,210,106,0.3));
    padding: 2px 10px;
    border-radius: 100px;
    font-size: 0.6rem;
  }
  .paper-authors {
    font-size: 0.8rem;
    color: var(--hf-text-muted, #888);
  }
  .paper-author { font-weight: 600; color: var(--hf-text, #fff); }
  html[data-theme-mode="light"] .paper-author { color: var(--hf-text, #1A1A18); }
  .paper-author-div { opacity: 0.3; margin: 0 4px; }
  .paper-org { color: var(--hf-accent); text-decoration: none; }
  .paper-title-area { margin-bottom: 32px; }
  .paper-title {
