    { tag: t('indagaciones.item4.tag'), title: t('indagaciones.item4.titulo'), fecha: t('indagaciones.item4.fecha'), color: '#3B82F6', recent: false },
  ])}>
  <div class="ticker-header">
    <span class="ticker-header-badge">{t('indagaciones.tag')}</span>
    <span class="ticker-header-live">
      <span class="ticker-live-dot"></span>
      {locale === 'es' ? '7 entregas · en vivo' : '7 deliveries · live'}
    </span>
  </div>
  <div class="ticker-track" id="hf-ticker">
    <div class="ticker-inner" id="hf-ticker-inner"></div>
  </div>
</section>

<script is:inline data-astro-rerun>
(function() {
  var wrap = document.querySelector('.ticker-wrap');
  if (!wrap) return;
  var raw = wrap.getAttribute('data-items');
  var items;
  try { items = JSON.parse(raw); } catch(e) { return; }
  if (!items || !items.length) return;

  // Double the items for seamless loop
  var doubled = items.concat(items);
  var inner = document.getElementById('hf-ticker-inner');
  if (!inner) return;

  inner.innerHTML = doubled.map(function(item, idx) {
    var color = item.color || 'var(--hf-accent)';
    var isRecent = item.recent;
    var pulseDur = isRecent ? '1.5s' : '3s';
    var animName = isRecent ? 'tickerPulseRecent' : 'tickerPulseOld';
    var dotSize = isRecent ? '14px' : '10px';
    var glowIntensity = isRecent ? '0 0 14px ' + color : '0 0 6px ' + color;
    var tagBg = color + '20';
    var tagBorder = color + '40';
    return '<div class="ticker-item' + (isRecent ? ' ticker-item--recent' : '') + '" style="border-color:' + color + '60;' + (isRecent ? 'border-width:1.5px;' : '') + '">' +
      '<span class="ticker-dot" style="background:' + color + ';box-shadow:' + glowIntensity + ';animation:' + animName + ' ' + pulseDur + ' ease-in-out infinite;width:' + dotSize + ';height:' + dotSize + ';"></span>' +
      '<span class="ticker-meta">' +
        '<span class="ticker-tag" style="background:' + tagBg + ';border-color:' + tagBorder + ';color:' + color + ';">' + item.tag + '</span>' +
        '<span class="ticker-fecha">' + item.fecha + '</span>' +
      '</span>' +
      '<span class="ticker-title">' + item.title + '</span>' +
    '</div>';
  }).join('');

  // Calculate animation duration based on total width
  var totalWidth = 0;
  var children = inner.children;
  for (var i = 0; i < children.length; i++) {
    totalWidth += children[i].offsetWidth;
  }
  var duration = Math.max(20, totalWidth / 80); // ~80px per second
  inner.style.setProperty('--ticker-duration', duration + 's');
  inner.style.animationDuration = duration + 's';
  inner.style.animationPlayState = 'running';

  // Pause on hover
  var track = document.getElementById('hf-ticker');
  if (track) {
    track.addEventListener('mouseenter', function() { inner.style.animationPlayState = 'paused'; });
    track.addEventListener('mouseleave', function() { inner.style.animationPlayState = 'running'; });
  }

  // Accessibility: reduce motion
  var mq = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (mq.matches) { inner.style.animation = 'none'; inner.style.transform = 'none'; }
})();
</script>

<style is:global>
  .ticker-wrap {
    background: var(--hf-bg-secondary, #111);
    border-top: 1px solid var(--hf-accent-border, rgba(0,210,106,0.15));
    border-bottom: 1px solid var(--hf-accent-border, rgba(0,210,106,0.15));
    padding: 12px 0;
    overflow: hidden;
    position: relative;
  }
  html[data-theme-mode="light"] .ticker-wrap {
    background: color-mix(in srgb, var(--hf-accent) 5%, var(--hf-bg-secondary));
    border-color: color-mix(in srgb, var(--hf-accent) 20%, transparent);
  }
  .ticker-wrap::before, .ticker-wrap::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    width: 60px;
    z-index: 2;
    pointer-events: none;
  }
  .ticker-wrap::before { left: 0; background: linear-gradient(90deg, var(--hf-bg-secondary, #111) 0%, transparent 100%); }
  .ticker-wrap::after { right: 0; background: linear-gradient(270deg, var(--hf-bg-secondary, #111) 0%, transparent 100%); }
  .ticker-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 0 24px 10px;
  }
  .ticker-header-badge {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--hf-accent, #00D26A);
    border: 1px solid var(--hf-accent-border, rgba(0,210,106,0.3));
    padding: 3px 12px;
    border-radius: 100px;
  }
  .ticker-header-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--hf-text-dim, #666);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .ticker-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hf-accent, #00D26A);
    animation: tickerLivePulse 2s ease-in-out infinite;
  }
  @keyframes tickerLivePulse {
    0%, 100% { opacity: 1; transform: scale(1); box-shadow: 0 0 6px var(--hf-accent, #00D26A); }
    50% { opacity: 0.5; transform: scale(0.85); box-shadow: 0 0 0 transparent; }
  }
  .ticker-track { overflow: hidden; width: 100%; }
  .ticker-inner { display: flex; gap: 0; width: max-content; animation: tickerScroll var(--ticker-duration, 30s) linear infinite; will-change: transform; }
  @keyframes tickerScroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .ticker-item--recent {
    border-color: var(--hf-accent, #00D26A) !important;
    background: color-mix(in srgb, var(--hf-accent) 10%, var(--hf-bg)) !important;
    box-shadow: 0 0 24px color-mix(in srgb, var(--hf-accent) 12%, transparent);
  }
  html[data-theme-mode="light"] .ticker-item--recent {
    background: color-mix(in srgb, var(--hf-accent) 12%, white) !important;
  }
  .ticker-item--recent .ticker-title {
    color: var(--hf-accent, #00D26A) !important;
    font-weight: 500 !important;
  }
  .ticker-item {
    display: flex; align-items: center; gap: 10px;
    padding: 6px 16px 6px 12px; margin: 0 8px;
    white-space: nowrap; flex-shrink: 0; font-size: 0.85rem;
    color: var(--hf-text-secondary, #ccc);
    border: 1px solid; border-radius: 100px;
    background: color-mix(in srgb, var(--hf-bg) 60%, transparent);
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .ticker-item:hover { box-shadow: 0 0 20px color-mix(in srgb, currentColor 15%, transparent); }
  html[data-theme-mode="light"] .ticker-item { background: color-mix(in srgb, var(--hf-bg-secondary) 80%, transparent); color: var(--hf-text-muted, #555); }
  .ticker-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; display: inline-block; }
  @keyframes tickerPulseRecent { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.3); opacity: 0.6; } }
  @keyframes tickerPulseOld { 0%, 100% { transform: scale(1); opacity: 0.6; } 50% { transform: scale(1.1); opacity: 0.3; } }
  .ticker-meta { display: inline-flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .ticker-fecha { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; font-weight: 600; color: var(--hf-text-dim, #666); letter-spacing: 0.04em; text-transform: uppercase; }
  .ticker-sep { display: none; }
  .ticker-tag { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 2px 8px; border-radius: 100px; border: 1px solid; }
  .ticker-title { font-weight: 400; color: var(--hf-text, #fff); max-width: 360px; overflow: hidden; text-overflow: ellipsis; font-size: 0.82rem; }
  html[data-theme-mode="light"] .ticker-title { color: var(--hf-text-secondary, #333); }
</style>

