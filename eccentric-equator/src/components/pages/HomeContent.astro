<!-- Mobile Menu Toggle Script -->
<script>
  document.addEventListener('astro:page-load', () => {
    const menuBtn = document.querySelector('.mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const body = document.body;
    
    if (menuBtn && mobileMenu) {
      menuBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = mobileMenu.classList.toggle('active');
        menuBtn.classList.toggle('active');
        menuBtn.setAttribute('aria-expanded', isOpen.toString());
        menuBtn.setAttribute('aria-label', isOpen ? 'Close mobile menu' : 'Open mobile menu');
        body.style.overflow = isOpen ? 'hidden' : '';
        // Fix language switcher contrast on dark overlay
        if (isOpen) {
          var langSwitcher = document.querySelector('.lang-switcher');
          if (langSwitcher && !langSwitcher.dataset.hfFixed) {
            langSwitcher.dataset.hfFixed = '1';
            langSwitcher.style.setProperty('background', 'rgba(255,255,255,0.08)', 'important');
            langSwitcher.style.setProperty('border-color', 'rgba(255,255,255,0.2)', 'important');
            langSwitcher.style.setProperty('color', '#e0e0e0', 'important');
          }
        }
      });
      
      // Close menu when clicking on a link
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('active');
          menuBtn.classList.remove('active');
          menuBtn.setAttribute('aria-expanded', 'false');
          menuBtn.setAttribute('aria-label', 'Open mobile menu');
          body.style.overflow = '';
        });
      });
      
      // Close menu when clicking outside
      mobileMenu.addEventListener('click', (e) => {
        if (e.target === mobileMenu) {
          mobileMenu.classList.remove('active');
          menuBtn.classList.remove('active');
          menuBtn.setAttribute('aria-expanded', 'false');
          menuBtn.setAttribute('aria-label', 'Open mobile menu');
          body.style.overflow = '';
        }
      });
    }

    // Navigation scroll effect
    const nav = document.querySelector('.nav');
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        nav?.classList.add('scrolled');
      } else {
        nav?.classList.remove('scrolled');
      }
    });
  });

  // Chrono-spec tooltip toggle (touch devices only)
  (function() {
    if (!window.matchMedia('(hover: none)').matches) return;

    document.addEventListener('click', function(e) {
      var s = e.target.closest('.chrono-spec');
      var u = e.target.closest('.chrono-unit');

      // Tap on tooltip → close
      if (s) {
        u && u.classList.remove('active');
        return;
      }
      // Tap on gear → toggle
      if (u) {
        var all = document.querySelectorAll('.chrono-unit');
        for (var i = 0; i < all.length; i++) {
          if (all[i] !== u) all[i].classList.remove('active');
        }
        u.classList.toggle('active');
        return;
      }
      // Tap outside → close all
      var all = document.querySelectorAll('.chrono-unit');
      for (var i = 0; i < all.length; i++) all[i].classList.remove('active');
    });
  })();
</script>

<!-- Newsletter Subscription Script -->
<script>
  import { subscribeEmail } from '../../lib/subscription';

  // ===== CONFIGURATION =====
  const MAX_EMAIL_LENGTH = 254;
  const ALLOWED_EMAIL_CHARS = /^[a-zA-Z0-9@._-]+$/;

  // ===== PROBLEM FORM HANDLER =====
  const problemForm = document.getElementById("problem-form");
  const problemMessage = document.getElementById("problem-form-message");

  if (problemForm && problemMessage) {
    problemForm.addEventListener("submit", async function (e) {
      e.preventDefault();

      const name = (document.getElementById("problem-name") as HTMLInputElement)?.value.trim() || "";
      const email = (document.getElementById("problem-email") as HTMLInputElement)?.value.trim();
      const area = (document.getElementById("problem-area") as HTMLSelectElement)?.value;
      const contact = (document.getElementById("problem-contact") as HTMLSelectElement)?.value;
      const description = (document.getElementById("problem-description") as HTMLTextAreaElement)?.value.trim();

      const getMsg = (key: string) => problemForm?.getAttribute(`data-msg-${key}`) || '';

      if (!email || !description) {
        problemMessage.textContent = getMsg('required');
        problemMessage.className = "form-message error";
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        problemMessage.textContent = getMsg('email-invalid');
        problemMessage.className = "form-message error";
        return;
      }

      problemMessage.textContent = getMsg('sending');
      problemMessage.className = "form-message info";

      const locale = window.location.pathname.startsWith('/en') ? 'en' : 'es';

      try {
        const BOT_TOKEN = import.meta.env.PUBLIC_TELEGRAM_BOT_TOKEN;
        const CHAT_ID = import.meta.env.PUBLIC_TELEGRAM_CHAT_ID;
        const esc = (t: string) => (t || '').replace(/[<>&]/g, (c) => ({'<':'&lt;','>':'&gt;','&':'&amp;'}[c] || c));

        const areaLabels: Record<string,string> = { security: 'Seguridad', architecture: 'Arquitectura', behavior: 'Comportamiento organizacional', intelligence: 'Inteligencia estratégica', other: 'Otro' };
        const contactLabels: Record<string,string> = { email: 'Email', meeting: 'Reunión breve', depends: 'Depende' };

        const text = '<b>🔬 Nuevo problema recibido</b>\n<b>Nombre:</b> ' + esc(name || '(sin nombre)') + '\n<b>Email:</b> ' + esc(email) + '\n<b>Área:</b> ' + esc(areaLabels[area] || area || '') + '\n<b>Contacto:</b> ' + esc(contactLabels[contact] || contact || '') + '\n<b>Descripción:</b>\n' + esc(description) + '\n<b>Fecha:</b> ' + new Date().toISOString();

        if (BOT_TOKEN && CHAT_ID) {
          const res = await fetch('https://api.telegram.org/bot' + BOT_TOKEN + '/sendMessage', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ chat_id: Number(CHAT_ID), text, parse_mode: 'HTML' }),
          });
          if (res.ok) {
            problemMessage.textContent = getMsg('success');
            problemMessage.className = "form-message success";
            (problemForm as HTMLFormElement).reset();
            return;
          }
        }
        problemMessage.textContent = getMsg('error');
        problemMessage.className = "form-message error";
      } catch (err) {
        problemMessage.textContent = getMsg('network');
        problemMessage.className = "form-message error";
      }
    });
  }

  // ===== DOM ELEMENTS =====
  const emailInput = document.getElementById("email-input") as HTMLInputElement | null;
  const message = document.getElementById("form-message") as HTMLElement | null;

  // ===== VALIDATION FUNCTIONS =====

  function sanitizeEmail(email: string): string {
    email = email.trim();
    email = email.replace(/[^a-zA-Z0-9@._-]/g, '');
    return email;
  }

  function validateEmailFormat(email: string): boolean {
    const emailRegex = /^[a-zA-Z0-9][a-zA-Z0-9._-]*@[a-zA-Z0-9][a-zA-Z0-9.-]*\.[a-zA-Z]{2,}$/;
    return emailRegex.test(email);
  }

  function validateEmailLength(email: string): boolean {
    return email.length <= MAX_EMAIL_LENGTH;
  }

  function validateEmail(email: string): { valid: boolean; error?: string } {
    if (!email) {
      return { valid: false, error: "Email is required" };
    }

    if (!validateEmailLength(email)) {
      return { valid: false, error: `Email exceeds ${MAX_EMAIL_LENGTH} characters` };
    }

    if (!ALLOWED_EMAIL_CHARS.test(email)) {
      return { valid: false, error: "Invalid characters. Only letters, numbers, @._- allowed" };
    }

    if (!validateEmailFormat(email)) {
      return { valid: false, error: "Invalid email format. Use user@domain.com" };
    }

    return { valid: true };
  }

  // ===== REAL-TIME VALIDATION =====
  if (emailInput && message) {
    emailInput.addEventListener("input", function(e) {
      const target = e.target as HTMLInputElement;
      const email = target.value;
      const validation = validateEmail(email);

      if (email.length === 0) {
        message.textContent = "";
        message.className = "form-message";
        return;
      }

      if (!validation.valid) {
        message.textContent = validation.error ?? "";
        message.className = "form-message error";
        return;
      }

      message.textContent = "Valid email";
      message.className = "form-message success";
    });

    emailInput.addEventListener("blur", function(e) {
      const target = e.target as HTMLInputElement;
      const email = target.value;
      if (email.length === 0) {
        message.textContent = "";
        message.className = "form-message";
      }
    });

    const subscribeForm = document.getElementById("subscribe-form");
    subscribeForm?.addEventListener("submit", async function (e) {
        e.preventDefault();

        const email = sanitizeEmail(emailInput.value);
        const validation = validateEmail(email);

        if (!validation.valid) {
          message.textContent = validation.error ?? "";
          message.className = "form-message error";
          return;
        }

        message.className = "form-message info";
        message.textContent = "Subscribing...";

        try {
          const result = await subscribeEmail(email);

          if (result.success) {
            message.textContent = "Successfully subscribed!";
            emailInput.value = "";
            message.className = "form-message success";
            return;
          }
          if (result.message === 'Already subscribed.') {
            message.textContent = "Already subscribed.";
            message.className = "form-message warning";
            return;
          }
          message.textContent = result.message || "Error. Please try again.";
          message.className = "form-message error";

        } catch (error) {
          console.error(error);
          message.textContent = "Network error. Check connection.";
          message.className = "form-message error";
        }
      });
  }
</script>

