    background-image: 
      linear-gradient(30deg, var(--hf-border) 1px, transparent 1px),
      linear-gradient(150deg, var(--hf-border) 1px, transparent 1px);
    background-size: 40px 69.28px;
    opacity: 0.1;
    pointer-events: none;
  }

  .hero-abstract {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.15;
    mix-blend-mode: screen;
  }

  @media (max-width: 767px) {
    .hero-abstract { opacity: 0.08; }
  }

  .hero-abstract-svg {
    width: 100%;
    height: 100%;
  }

  .abs-ring {
    fill: none;
    stroke-width: 0.8;
    opacity: 0.6;
  }
  .abs-ring--human { stroke: var(--hf-accent-human, #9C5E4D); }
  .abs-ring--privacy { stroke: var(--hf-accent-privacy, #1E3A5F); }
  .abs-ring--analysis { stroke: var(--hf-accent-analysis, #6C4F9E); }
  .abs-ring--philosophy { stroke: var(--hf-accent-philosophy, #7A6A4E); }

  .abs-strand {
    stroke: var(--hf-text);
    stroke-width: 0.5;
    opacity: 0.12;
    stroke-dasharray: 3 6;
  }
  .abs-strand--dim { opacity: 0.06; }

  .hero-content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
    width: 100%;
    padding-bottom: 80px;
  }

  @media (min-width: 1024px) {
    .hero-content {
      grid-template-columns: 1fr 1fr;
      text-align: left;
      gap: 64px;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  @media (max-width: 1023px) {
    .hero-text {
      align-items: center;
      text-align: center;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: var(--hf-accent-dim);
    border: 1px solid var(--hf-accent-border);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--primary);
    margin-bottom: 28px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .hero-title-accent {
    color: var(--hf-accent);
    font-family: 'Source Serif 4', 'Georgia', serif;
    font-weight: 600;
    font-style: italic;
    display: block;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    color: var(--gray-400);
    max-width: 540px;
    margin: 0 0 40px;
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 0;
  }

  @media (max-width: 1023px) {
    .hero-actions {
      justify-content: center;
    }
  }

  .hero-proof {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding: 13px 18px;
    border: 1px solid color-mix(in srgb, var(--hf-text) 12%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--hf-text) 4%, transparent);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .hero-proof:hover {
    border-color: color-mix(in srgb, var(--hf-text) 22%, transparent);
    background: color-mix(in srgb, var(--hf-text) 7%, transparent);
  }

  @media (max-width: 1023px) {
    .hero-proof {
      width: 100%;
      max-width: 360px;
    }
  }

  .hero-proof-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hf-accent-border);
    border-radius: 9px;
    background: var(--hf-accent-dim);
  }

  .hero-proof-icon svg {
    width: 18px;
    height: 18px;
    stroke: var(--primary);
  }

  .hero-proof-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero-proof-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--primary);
    opacity: 0.75;
  }

  .hero-proof-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--white);
    transition: color 0.2s ease;
  }

  .hero-proof:hover .hero-proof-link {
    color: var(--primary);
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 16px 32px;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    min-height: 48px;
    min-width: 48px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    position: relative;
    overflow: hidden;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255,255,255,0.12) 0%, transparent 50%);
    pointer-events: none;
    border-radius: inherit;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--hf-accent) 0%, color-mix(in srgb, var(--hf-accent) 80%, #000) 100%);
    color: var(--hf-bg);
    box-shadow: 0 4px 20px color-mix(in srgb, var(--hf-accent) 35%, transparent);
  }

  .btn-primary span,
  .btn-primary svg {
    position: relative;
    z-index: 1;
  }

  .btn-primary span {
    color: var(--hf-text-on-accent);
    font-weight: 700;
  }

  .btn-primary svg {
    stroke: var(--hf-bg);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--hf-accent) 45%, transparent);
  }

  .btn-secondary {
    background: transparent;
    color: var(--white);
    border: 1px solid color-mix(in srgb, var(--hf-text) 20%, transparent);
    backdrop-filter: blur(4px);
  }

  .btn-secondary:hover {
    background: color-mix(in srgb, var(--hf-text) 6%, transparent);
    border-color: color-mix(in srgb, var(--hf-text) 35%, transparent);
    transform: translateY(-2px);
  }

  .btn-ghost {
    background: color-mix(in srgb, var(--hf-text) 4%, transparent);
    color: var(--gray-300);
    border: 1px solid color-mix(in srgb, var(--hf-text) 10%, transparent);
    font-size: 0.95rem;
    backdrop-filter: blur(4px);
  }

  .btn-ghost:hover {
    color: var(--hf-accent);
    border-color: color-mix(in srgb, var(--hf-accent) 40%, transparent);
    background: color-mix(in srgb, var(--hf-accent) 8%, transparent);
    transform: translateY(-2px);
  }

  .btn-large {
    padding: 20px 48px;
    font-size: 1.1rem;
  }

  .btn-full {
    width: 100%;
  }

  /* Architecture diagram */
  .hero-diagram {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .arch-diagram {
    width: 100%;
    max-width: 420px;
    height: auto;
  }

  .arch-line {
    stroke: var(--hf-accent);
    stroke-width: 1.5;
    opacity: 0.35;
  }

  .arch-line--dim {
    opacity: 0.18;
    stroke-dasharray: 4 4;
  }
  .arch-line--cross {
    opacity: 0.12;
    stroke-dasharray: 2 8;
    stroke-width: 1;
  }

  .arch-node {
    fill: none;
    stroke: var(--hf-accent);
    stroke-width: 1.5;
    opacity: 0.5;
  }

  .arch-node--primary {
    opacity: 0.8;
    stroke-width: 2;
  }

  .arch-node--secondary {
    opacity: 0.6;
  }

  .arch-node--organic {
    stroke: var(--hf-accent-human);
    opacity: 0.6;
  }

  .arch-node--abstract {
    stroke: var(--hf-accent-philosophy);
    opacity: 0.5;
  }

  .arch-node--tertiary {
    opacity: 0.4;
  }

  .arch-node-inner {
    fill: var(--hf-accent);
    stroke: none;
    opacity: 0.12;
  }

  .arch-pulse {
    fill: none;
    stroke: var(--hf-accent);
    stroke-width: 1;
    opacity: 0;
    animation: archPulse 3s ease-out infinite;
  }

  .arch-pulse--delay1 {
    animation-delay: 1s;
  }

  .arch-pulse--delay2 {
    animation-delay: 2s;
  }

  .arch-pulse--organic {
    stroke: var(--hf-accent-human);
  }

  @keyframes archPulse {
    0% { opacity: 0.6; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.15); }
  }

  .arch-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    fill: var(--hf-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Sections */
  section {
    padding: 120px 0;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 80px;
  }

  .section-tag {
    display: inline-block;
    padding: 6px 18px;
    background: linear-gradient(135deg, var(--hf-accent-dim) 0%, color-mix(in srgb, var(--hf-accent) 5%, transparent) 100%);
    border: 1px solid color-mix(in srgb, var(--hf-accent) 20%, transparent);
    border-radius: 100px;
    font-size: 0.78rem;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin-bottom: 20px;
    font-weight: 600;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 20px;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--gray-400);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Services */
  .services {
    background: var(--dark);
  }

  /* ── Services Chronograph (High-End Precision) ── */
  .services-chronograph {
    max-width: 1100px;
    margin: 20px auto 40px; /* Reduced vertical margins */
    padding: 0 24px;
    position: relative;
  }

  /* Connecting Aristas Style */
  .chrono-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.15;
    pointer-events: none;
  }

  html[data-theme-mode="light"] .chrono-mesh {
    opacity: 0.5; /* Increased container visibility for light themes */
  }
  
  .chrono-mesh svg { width: 100%; height: 100%; }
  
  .mesh-line {
    stroke: var(--hf-accent);
    stroke-width: 1;
    fill: none;
    stroke-dasharray: 4 4;
    animation: meshFlow 20s linear infinite;
  }

  html[data-theme-mode="light"] .mesh-line {
    stroke: var(--hf-text-muted); /* High contrast gray for white backgrounds */
    stroke-width: 1.2;
  }

  .mesh-line--alt {
    stroke: var(--hf-accent-human, #9C5E4D);
    opacity: 0.5;
    animation-duration: 30s;
    animation-direction: reverse;
  }

  html[data-theme-mode="light"] .mesh-line--alt {
    stroke: var(--hf-accent-human);
    stroke-width: 1;
  }

  @keyframes meshFlow {
    from { stroke-dashoffset: 200; }
    to { stroke-dashoffset: 0; }
  }

  .chronograph-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .chronograph-grid { grid-template-columns: repeat(4, 1fr); gap: 40px 20px; }
  }

  /* Section Padding Reductions */
  section {
    padding: 80px 0; /* Reduced from 120px */
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px; /* Reduced from 80px */
  }

  .services {
    background: var(--dark);
    padding-bottom: 40px; /* Tighten bottom */
  }

  .about {
    position: relative;
    background: var(--hf-bg-secondary);
    border-bottom: 1px solid var(--hf-border);
    padding-top: 60px; /* Reduced to bring closer to services */
  }

  .chronograph-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 30px;
  }

  @media (min-width: 768px) {
    .chronograph-grid { grid-template-columns: repeat(4, 1fr); gap: 40px; }
  }

  .chrono-node {
    position: relative;
    aspect-ratio: 1;
    animation: chronoFadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: var(--delay);
  }

  @keyframes chronoFadeIn {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .chrono-unit {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: crosshair;
    position: relative;
  }

  /* Precision Rims */
  .chrono-rim-outer,
  .chrono-rim-inner {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 0.5px solid color-mix(in srgb, var(--chrono-color) 20%, var(--hf-border));
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .chrono-rim-outer {
    border-style: dashed;
    border-width: 1px;
    animation: chronoRotate 60s linear infinite;
  }

  .chrono-rim-inner {
    inset: 15%;
    border-style: solid;
    opacity: 0.3;
    animation: chronoRotate 40s linear infinite reverse;
  }

  .chrono-unit:hover .chrono-rim-outer {
    inset: -10px;
    border-color: var(--chrono-color);
    border-style: solid;
    opacity: 0.6;
    animation-duration: 10s;
  }

  .chrono-unit:hover .chrono-rim-inner {
    inset: 10%;
    opacity: 0.8;
    border-color: var(--chrono-color);
    animation-duration: 5s;
  }

  @keyframes chronoRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .chrono-content {
    position: relative;
    z-index: 5;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .chrono-icon {
    width: 32px;
    height: 32px;
    color: var(--chrono-color);
    transition: all 0.4s ease;
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--chrono-color) 30%, transparent));
  }

  .chrono-title {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--hf-text-secondary);
    max-width: 125px;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .chrono-unit:hover .chrono-title {
    color: var(--hf-text);
  }

  /* ── Technical Spec Sheet (Tooltip) ── */
  .chrono-spec {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 300px;
    padding: 24px;
    background: color-mix(in srgb, var(--hf-bg-elevated) 98%, #fff);
    backdrop-filter: blur(20px);
    border: 1px solid var(--hf-border);
    box-shadow: 0 30px 60px rgba(0,0,0,0.6);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -40%) scale(0.95);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 100;
    pointer-events: none;
  }

  @media (hover: hover) {
    .chrono-unit:hover .chrono-spec {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, -50%) scale(1);
      pointer-events: auto;
    }
  }
  .chrono-unit.active .chrono-spec {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
  }

  .spec-header {
    margin-bottom: 16px;
    border-bottom: 1px solid var(--hf-border);
    padding-bottom: 12px;
  }

  .spec-code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    color: var(--chrono-color);
    display: block;
    margin-bottom: 4px;
    letter-spacing: 0.1em;
  }

  .spec-header h4 {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--hf-text);
  }

  .chrono-spec p {
    font-size: 0.85rem;
    color: var(--gray-400);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .spec-link {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--hf-accent);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    display: inline-block;
    border-bottom: 1px solid transparent;
    transition: all 0.3s;
  }

  .spec-link:hover {
    color: var(--hf-accent-light);
    border-bottom-color: var(--hf-accent);
  }

  @media (max-width: 767px) {
    .chrono-node {
      animation: none;
    }
    .chrono-spec {
      position: fixed;
      left: 16px;
      right: 16px;
      bottom: 16px;
      top: auto;
      width: auto;
      padding: 16px;
      border-radius: 12px;
      max-height: 40vh;
      overflow-y: auto;
      transform: translateY(20px);
    }
    .chrono-spec p { font-size: 0.8rem; margin-bottom: 12px; }
    .spec-header { margin-bottom: 10px; padding-bottom: 8px; }
    .spec-header h4 { font-size: 0.8rem; }
    .spec-code { font-size: 0.55rem; }
    @media (hover: hover) {
      .chrono-unit:hover .chrono-spec { transform: translateY(0); }
    }
    .chrono-unit.active .chrono-spec { transform: translateY(0); }
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  /* ── Gear Card ── */
  .gear-card {
    position: relative;
    background: var(--hf-bg-card);
    border: 1px solid color-mix(in srgb, var(--gear-color, var(--hf-accent)) 20%, var(--hf-border));
    border-radius: 14px;
    padding: 28px 16px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    cursor: default;
    overflow: visible;
    animation: gearFadeIn 0.6s ease-out both;
    animation-delay: var(--delay, 0s);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  @keyframes gearFadeIn {
    from { opacity: 0; transform: translateY(20px) scale(0.95); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  /* ── Gear teeth top & bottom ── */
  .gear-teeth-top,
  .gear-teeth-bottom {
    position: absolute;
    left: -1px;
    right: -1px;
    height: 8px;
    background: transparent;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
  }
  .gear-teeth-top {
    top: -5px;
  }
  .gear-teeth-bottom {
    bottom: -5px;
  }

  .gear-teeth-top::before,
  .gear-teeth-bottom::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 100%;
    background: repeating-radial-gradient(
      ellipse 6px 6px at 12px center,
      color-mix(in srgb, var(--gear-color, var(--hf-accent)) 40%, var(--hf-border)) 0px,
      color-mix(in srgb, var(--gear-color, var(--hf-accent)) 40%, var(--hf-border)) 5px,
      transparent 5px,
      transparent 10px
    );
    background-size: 24px 100%;
  }

  .gear-card:hover .gear-teeth-top::before,
  .gear-card:hover .gear-teeth-bottom::before {
    background: repeating-radial-gradient(
      ellipse 6px 6px at 12px center,
      var(--gear-color, var(--hf-accent)) 0px,
      var(--gear-color, var(--hf-accent)) 5px,
      transparent 5px,
      transparent 10px
    );
  }

  /* ── Rotor (gear SVG) ── */
  .gear-rotor {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  .gear-rotor svg {
    width: 85%;
    height: 85%;
    stroke: color-mix(in srgb, var(--gear-color, var(--hf-accent)) 8%, transparent);
    fill: none;
    animation: gearSpin var(--rot-speed, 6s) linear infinite;
  }

  .gear-card:hover .gear-rotor svg {
    stroke: color-mix(in srgb, var(--gear-color, var(--hf-accent)) 20%, transparent);
    animation-duration: calc(var(--rot-speed, 6s) * 0.3);
  }

  /* Each adjacent card rotates in opposite direction */
  .gear-card:nth-child(even) .gear-rotor svg {
    animation-direction: reverse;
  }

  @keyframes gearSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* ── Icon ── */
  .gear-card-icon {
    position: relative;
    z-index: 1;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gear-color, var(--hf-accent));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gear-card-icon svg {
    width: 100%;
    height: 100%;
  }

  .gear-card:hover .gear-card-icon {
    transform: scale(1.15);
  }

  /* ── Title ── */
  .gear-card-title {
    position: relative;
    z-index: 1;
    font-size: 0.8rem;
    font-weight: 700;
