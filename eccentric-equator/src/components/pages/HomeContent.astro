    { tag: t('indagaciones.item1.tag'), title: t('indagaciones.item1.titulo'), fecha: t('indagaciones.item1.fecha'), color: '#F59E0B', recent: true },
    { tag: t('indagaciones.item2.tag'), title: t('indagaciones.item2.titulo'), fecha: t('indagaciones.item2.fecha'), color: '#6C4F9E', recent: false },
