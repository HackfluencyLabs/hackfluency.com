---
import ResearchNav from '../ResearchNav.astro';

export interface ArticleMeta {
  title: string;
  description: string;
  tags: string[];
  date: string;
  readTime: string;
  author: string;
  badge?: string;
}

export interface Props {
  meta: ArticleMeta;
  children: any;
  locale?: 'es' | 'en';
}

const { meta, locale = 'es' } = Astro.props;
const giscusLang = locale === 'es' ? 'es' : 'en';
---

<ResearchNav activePage="articles" locale={locale} />

<main class="rpage art-main">

  <article class="art-container">

    <!-- Hero -->
    <header class="art-hero">
      <div class="art-meta-row">
        <div class="art-tags">
          {meta.tags.map(tag => <span class="art-tag">{tag}</span>)}
        </div>
        {meta.badge && <span class="art-badge">{meta.badge}</span>}
      </div>
      <h1 class="art-title">{meta.title}</h1>
      <p class="art-desc">{meta.description}</p>
      <div class="art-byline">
        <span class="art-author">{meta.author}</span>
        <span class="art-sep">·</span>
        <time class="art-date">{meta.date}</time>
        <span class="art-sep">·</span>
        <span class="art-read">{meta.readTime}</span>
      </div>
    </header>

    <!-- Content -->
    <div class="art-body">
      <slot />
    </div>

  </article>

  <!-- Closing Panel -->
  <div class="art-closing-panel">
    <div class="art-closing-inner">

      <!-- Reactions -->
      <div class="art-claps-box">
        <div class="art-claps" id="art-claps-root" data-slug="zero-day-ia-google">
          <span class="art-claps-count" id="art-claps-count">0</span>
          <button class="art-claps-btn" id="art-claps-btn" aria-label="React">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="position:absolute">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" opacity="0.15" transform="scale(1.5) translate(-4,-4)"/>
            </svg>
            <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" stroke="none">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </button>
          <span class="art-claps-label">{locale === 'es' ? 'destellos' : 'sparkles'}</span>
        </div>
      </div>

      <!-- Comments -->
      <div class="art-comments-box">
      <div id="cusdis_thread"
        data-host="https://cusdis.com"
        data-app-id="90d95120-41f5-4baa-8285-8e91d4d96c45"
        data-page-id="zero-day-ia-google"
        data-page-url={Astro.url.href}
        data-page-title={meta.title}
        data-lang={locale === 'es' ? 'es' : 'en'}
      ></div>

<script is:inline>
(function() {
  var thread = document.getElementById('cusdis_thread');
  if (!thread) return;

  function applyCusdisTheme() {
    var iframe = thread.querySelector('iframe');
    if (!iframe) return;
    try {
      var doc = iframe.contentDocument || iframe.contentWindow.document;
      if (!doc || !doc.documentElement || !doc.documentElement.classList) return;
      var isDark = document.documentElement.getAttribute('data-theme-mode') === 'dark';
      if (isDark) {
        doc.documentElement.classList.add('dark');
        var s = doc.querySelector('style');
        if (s) {
          s.textContent = s.textContent.replace('color-scheme: light', 'color-scheme: dark');
          if (!s.textContent.includes('/*hf-cusdis-btn*/')) {
            s.textContent += '/*hf-cusdis-btn*/.dark button.dark\\:bg-transparent{color:#e5e7eb!important}';
          }
        }
      } else {
        doc.documentElement.classList.remove('dark');
        var s = doc.querySelector('style');
        if (s) s.textContent = s.textContent.replace('color-scheme: dark', 'color-scheme: light');
      }
    } catch(e) {}
  }

  // Watch iframe changes (Cusdis creates/replaces iframe on render)
  var observer = new MutationObserver(applyCusdisTheme);
  observer.observe(thread, { childList: true, subtree: true });

  // Polling fallback — runs forever, always applies latest theme
  setInterval(applyCusdisTheme, 800);

  // Initial theme
  var mode = document.documentElement.getAttribute('data-theme-mode') || 'dark';
  thread.setAttribute('data-theme', mode === 'light' ? 'light' : 'dark');
  setTimeout(applyCusdisTheme, 300);
  setTimeout(applyCusdisTheme, 1500);

  // Theme switch — no CUSDIS.render(), just let observer+polling handle it
  window.addEventListener('hf-theme-change', function() {
    var mode = document.documentElement.getAttribute('data-theme-mode') || 'dark';
    thread.setAttribute('data-theme', mode === 'light' ? 'light' : 'dark');
    applyCusdisTheme();
  });
})();
</script>
<script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
      </div>

    </div>
  </div>

  <!-- Article Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {JSON.stringify(meta.title)},
    "description": {JSON.stringify(meta.description)},
    "author": {
      "@type": "Person",
      "name": {JSON.stringify(meta.author)}
    },
    "datePublished": {JSON.stringify(meta.date)},
    "timeRequired": {JSON.stringify(meta.readTime)},
    "inLanguage": {JSON.stringify(locale === 'es' ? 'es' : 'en')},
    "publisher": {
      "@type": "Organization",
      "name": "Hackfluency Research"
    }
  }
  </script>

</main>

<!-- Footer -->
<footer class="art-footer">
  <div class="art-footer-inner">
    <a href={locale === 'es' ? '/research/articles' : '/en/research/articles'} class="art-footer-back">&larr; {locale === 'es' ? 'Volver a Artículos' : 'Back to Articles'}</a>
    <span class="art-footer-copy">{locale === 'es' ? '© 2026 Hackfluency' : '© 2026 Hackfluency'}</span>
    <a href="https://hackfluency.zohobookings.com/#/hackfluency" target="_blank" rel="noopener" class="art-footer-cta">{locale === 'es' ? 'Contacto' : 'Contact'}</a>
  </div>
</footer>

<script>
(function() {
  const clapsKey = 'hf_claps_zero-day-ia-google';
  const btn = document.getElementById('art-claps-btn');
  const countEl = document.getElementById('art-claps-count');
  const slug = 'zero-day-ia-google';
  let count = 0;
  let clapped = localStorage.getItem(clapsKey) === 'true';

  function updateCount(n) {
    count = n;
    if (countEl) countEl.textContent = count;
  }

  // Fetch current count with retry
  function fetchCount(retries) {
    var controller = new AbortController();
    var timeout = setTimeout(function() { controller.abort(); }, 5000);
    fetch(`https://yfofmawbvlontugygfcj.supabase.co/rest/v1/article_claps?slug=eq.${slug}&select=count`, {
      headers: { 'apikey': 'sb_publishable_EFI12D4AaO2Y7o5gyWrB-g_i--T5Arz' },
      signal: controller.signal
    })
    .then(function(r) { clearTimeout(timeout); return r.json(); })
    .then(function(data) {
      if (data && data.length > 0) updateCount(data[0].count);
    })
    .catch(function() {
      clearTimeout(timeout);
      if (retries > 0) setTimeout(function() { fetchCount(retries - 1); }, 1500);
    });
  }
  fetchCount(3);

  if (btn) {
    btn.addEventListener('click', function() {
      if (clapped) return;
      clapped = true;
      localStorage.setItem(clapsKey, 'true');
      const newCount = count + 1;
      updateCount(newCount);
      btn.classList.add('clapped');

      // Upsert: insert if not exists, update count if exists
      fetch(`https://yfofmawbvlontugygfcj.supabase.co/rest/v1/article_claps`, {
        method: 'POST',
        headers: {
          'apikey': 'sb_publishable_EFI12D4AaO2Y7o5gyWrB-g_i--T5Arz',
          'Content-Type': 'application/json',
          'Prefer': 'resolution=merge-duplicates'
        },
        body: JSON.stringify({ slug: slug, count: newCount })
      }).catch(() => {});
    });
  }
})();
</script>

