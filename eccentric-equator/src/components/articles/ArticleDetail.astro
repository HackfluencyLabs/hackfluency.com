---
import ResearchNav from '../ResearchNav.astro';
import ArticleGate from './ArticleGate.astro';

export interface ArticleMeta {
  title: string;
  description: string;
  tags: string[];
  date: string;
  readTime: string;
  author: string;
  badge?: string;
  layout?: 'technical' | 'essay' | 'reportage';
}

export interface Props {
  meta: ArticleMeta;
  children: any;
  locale?: 'es' | 'en';
  slug: string;
}

const { meta, locale = 'es' } = Astro.props;
const artLayout = meta.layout || 'technical';
const layoutClass = 'art-layout--' + artLayout;

---

<ResearchNav activePage="articles" locale={locale} />

<main class={"rpage art-main " + layoutClass}>

  <article class={"art-container " + layoutClass}>

    <!-- Hero -->
    <header class="art-hero">
      <div class="art-meta-row">
        <div class="art-tags">
          {meta.tags.map(tag => <span class="art-tag">{tag}</span>)}
        </div>
        {meta.badge && <span class="art-badge">{meta.badge}</span>}
      </div>
      <h1 class="art-title">{meta.title}</h1>
      <p class="art-desc">{meta.description}</p>
      <div class="art-byline">
        <span class="art-author">{meta.author}</span>
        <span class="art-sep">·</span>
        <time class="art-date">{meta.date}</time>
        <span class="art-sep">·</span>
        <span class="art-read">{meta.readTime}</span>
      </div>
    </header>

    <!-- Content -->
    <div class="art-body">
      <slot />
    </div>

  </article>

  <!-- Chat banner click handler -->
  <script is:inline data-astro-rerun>
  document.addEventListener('click', function(e) {
    var banner = e.target.closest('#art-chat-banner');
    if (!banner) return;
    var floating = document.getElementById('rt-d6023b7d7713a023f5e73ab154aa7c08');
    if (floating) {
      var btn = floating.querySelector('img[alt*="join"], img[alt*="conversation"], img[alt*="chat"], img[alt*="message"], a, button');
      if (btn) { btn.click(); return; }
      // Fallback: click the first img in the floating div
      var img = floating.querySelector('img');
      if (img) img.click();
    }
  });
  </script>

  <!-- Article Gate -- mid-scroll email capture -->
  <ArticleGate locale={locale} />

  <!-- Closing Panel -->
  <div class="art-closing-panel">
    <div class="art-closing-inner">

      <!-- Chat banner -->
      <div class="art-chat-banner" id="art-chat-banner" role="button" tabindex="0" aria-label={locale === 'es' ? 'Abrir chat' : 'Open chat'}>
        <div class="chat-banner-glow"></div>
        <div class="chat-banner-content">
          <span class="chat-banner-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
            </svg>
          </span>
          <span class="chat-banner-text">
            <span class="chat-banner-title">{locale === 'es' ? 'Deja un mensaje' : 'Leave a message'}</span>
            <span class="chat-banner-sub">{locale === 'es' ? 'Anónimo · Tiempo real · Otros usuarios conectados' : 'Anonymous · Live · Others are here'}</span>
          </span>
          <span class="chat-banner-dot"></span>
        </div>
      </div>

      <!-- Iine appreciation button -->
      <div class="art-iine-box">
        <button class="iine-button" aria-hidden="true" data-icon="heart"></button>
      </div>

    </div>
  </div>

  <!-- Article Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {JSON.stringify(meta.title)},
    "description": {JSON.stringify(meta.description)},
    "author": {
      "@type": "Person",
      "name": {JSON.stringify(meta.author)}
    },
    "datePublished": {JSON.stringify(meta.date)},
    "timeRequired": {JSON.stringify(meta.readTime)},
    "inLanguage": {JSON.stringify(locale === 'es' ? 'es' : 'en')},
    "publisher": {
      "@type": "Organization",
      "name": "Hackfluency Research"
    }
  }
  </script>

</main>

<!-- Iine wrapper: inicializa el widget "like" en cada navegación.
     iine.mini.js solo se inicializa en el evento DOMContentLoaded, que con
     View Transitions (SPA) no vuelve a dispararse. El listener que iine
     registra en `document` persiste entre navegaciones, así que cargamos el
     script una sola vez y re-despachamos DOMContentLoaded cuando hay un
     botón sin inicializar en el DOM nuevo. -->
<script is:inline data-astro-rerun>
(function () {
  var btn = document.querySelector('.iine-button');
  if (!btn) return;

  var dispatch = function () {
    document.dispatchEvent(new Event('DOMContentLoaded'));
  };
  var needsInit = function () {
    var b = document.querySelector('.iine-button');
    return b && !b.querySelector('.icon');
  };

  var boot = function () {
    var s = document.getElementById('hf-iine-script');
    if (!s) {
      s = document.createElement('script');
      s.id = 'hf-iine-script';
      s.src = 'https://cdn.jsdelivr.net/gh/welpo/iine@main/iine.mini.js';
      s.onload = function () {
        if (needsInit()) dispatch();
      };
      document.head.appendChild(s);
      return;
    }
    // Ya cargado: el listener de iine sigue vivo en `document`
    if (needsInit()) dispatch();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>

<!-- Footer -->
<footer class="art-footer">
  <div class="art-footer-inner">
    <a href={locale === 'es' ? '/research/articles' : '/en/research/articles'} class="art-footer-back">&larr; {locale === 'es' ? 'Volver a Artículos' : 'Back to Articles'}</a>
    <span class="art-footer-copy">{locale === 'es' ? '© 2026 Hackfluency' : '© 2026 Hackfluency'}</span>
    <a href={locale === 'es' ? '/#contact' : '/en#contact'} class="art-footer-cta">{locale === 'es' ? 'Contacto' : 'Contact'}</a>
  </div>
</footer>



<style is:global>
  .art-main {
    padding-top: 68px;
    background: var(--hf-bg, #0a0a0a);
    min-height: 100vh;
  }
  .art-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 80px 24px 48px;
  }
  .art-container-narrow {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Layout Variants ── */

  /* Essay — philosophy, psychology, human behavior */
  .art-layout--essay .art-container {
    max-width: 680px;
  }
  .art-layout--essay .art-body {
    font-size: 1.1rem;
    line-height: 2.1;
  }
  .art-layout--essay .art-body h2,
  .art-layout--essay .art-body h3 {
    font-family: 'Source Serif 4', 'Georgia', serif;
    font-weight: 600;
    letter-spacing: 0;
  }
  .art-layout--essay .art-body h2 {
    font-size: 1.7rem;
  }
  .art-layout--essay .art-body h3 {
    font-size: 1.3rem;
  }
  .art-layout--essay .art-body blockquote {
    font-family: 'Source Serif 4', 'Georgia', serif;
    font-style: italic;
    font-size: 1.05rem;
  }
  .art-layout--essay .art-title {
    font-family: 'Source Serif 4', 'Georgia', serif;
    font-weight: 700;
    letter-spacing: -0.3px;
  }

  /* Reportage — independent press, intelligence analysis */
  .art-layout--reportage .art-container {
    max-width: 760px;
  }
  .art-layout--reportage .art-body {
    font-size: 1.05rem;
    line-height: 1.85;
  }
  .art-layout--reportage .art-body blockquote {
    font-size: 1.1rem;
    padding: 32px 36px;
    border-left-width: 4px;
  }
  .art-layout--reportage .art-body blockquote::before {
    font-size: 3.5rem;
    top: 6px;
    left: 10px;
  }
  .art-layout--reportage .art-title {
    font-size: clamp(2.2rem, 5vw, 3rem);
  }

  /* Hero */
  .art-hero {
    margin-bottom: 64px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--hf-border-secondary, #2a2a2a);
    position: relative;
  }
  .art-hero::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 80px;
    height: 2px;
    background: var(--hf-accent, #00D26A);
    border-radius: 1px;
  }
  .art-meta-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .art-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .art-tag {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--hf-accent, #00D26A);
    background: var(--hf-accent-dim);
    border: 1px solid var(--hf-accent-border, var(--hf-border));
    padding: 4px 12px;
    border-radius: 100px;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }
  .art-tag:nth-child(1) { /* IA - purple glow */
    border-color: rgba(139,92,246,0.3);
    animation: tag-pulse-purple 3s ease-in-out infinite;
  }
  .art-tag:nth-child(2) { /* Seguridad - blue glow */
    border-color: rgba(59,130,246,0.3);
    animation: tag-pulse-blue 3s ease-in-out 0.4s infinite;
  }
  .art-tag:nth-child(3) { /* Zero-day - red glow */
    border-color: rgba(239,68,68,0.3);
    animation: tag-pulse-red 3s ease-in-out 0.8s infinite;
  }
  @keyframes tag-pulse-purple {
    0%, 100% { box-shadow: 0 0 0 transparent; }
    50% { box-shadow: 0 0 10px rgba(139,92,246,0.2), 0 0 2px rgba(139,92,246,0.1); }
  }
  @keyframes tag-pulse-blue {
    0%, 100% { box-shadow: 0 0 0 transparent; }
    50% { box-shadow: 0 0 10px rgba(59,130,246,0.2), 0 0 2px rgba(59,130,246,0.1); }
  }
  @keyframes tag-pulse-red {
    0%, 100% { box-shadow: 0 0 0 transparent; }
    50% { box-shadow: 0 0 10px rgba(239,68,68,0.2), 0 0 2px rgba(239,68,68,0.1); }
  }
  .art-tag:hover {
    transform: scale(1.05);
    border-color: var(--hf-accent, #00D26A);
  }
  .art-tag:hover {
    transform: scale(1.04);
  }
  .art-badge {
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #0d0d0d;
    background: linear-gradient(135deg, var(--hf-accent, #00D26A), #00a854);
    padding: 3px 10px;
    border-radius: 100px;
    text-transform: uppercase;
    animation: badge-pulse 2s ease-in-out infinite;
  }
  @keyframes badge-pulse {
    0%, 100% { opacity: 0.9; }
    50% { opacity: 1; box-shadow: 0 0 12px color-mix(in srgb, var(--hf-accent, #00D26A) 40%, transparent); }
  }
  .art-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    font-weight: 700;
    color: var(--hf-text);
    line-height: 1.12;
    margin-bottom: 20px;
    letter-spacing: -0.8px;
  }
  .art-desc {
    font-size: 1.05rem;
    color: var(--hf-text-secondary, #b0b0b0);
    line-height: 1.7;
    margin-bottom: 24px;
    max-width: 600px;
  }
  .art-byline {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    color: var(--hf-text-dim, #6a6a6a);
  }
  .art-sep { opacity: 0.3; }
  .art-author { font-weight: 600; color: var(--hf-text-secondary, #b0b0b0); }

  /* Body typography */
  .art-body {
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--hf-text-secondary, #b0b0b0);
    font-family: system-ui, -apple-system, 'Inter', sans-serif;
  }
  .art-body h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--hf-text);
    margin: 72px 0 24px;
    line-height: 1.3;
    letter-spacing: -0.3px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--hf-border-secondary, #2a2a2a);
  }
  .art-body h2:first-child { margin-top: 0; }
  .art-body h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--hf-text);
    margin: 48px 0 20px;
    letter-spacing: -0.2px;
  }
  .art-body p {
    margin-bottom: 28px;
  }
  .art-body a.src {
    background: linear-gradient(180deg, transparent 55%, rgba(255,200,0,0.25) 55%, rgba(255,200,0,0.15) 95%, transparent 95%);
    border-radius: 2px;
    padding: 0 2px;
    cursor: pointer;
    position: relative;
    font-weight: 500;
    transition: background 0.2s;
    color: inherit;
    text-decoration: none;
    border-bottom: none;
  }
  .art-body a.src:hover {
    background: linear-gradient(180deg, transparent 55%, rgba(255,200,0,0.4) 55%, rgba(255,200,0,0.25) 95%, transparent 95%);
  }
  .art-body a.src::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--hf-bg-elevated, #1a1a1a);
    border: 1px solid var(--hf-border, #222);
    color: var(--hf-text-secondary, #ccc);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    padding: 4px 8px;
    border-radius: 5px;
    white-space: nowrap;
    max-width: 360px;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
    z-index: 10;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }
  .art-body a.src:hover::after {
    opacity: 1;
  }
  .art-body blockquote {
    position: relative;
    border-left: 3px solid var(--hf-accent, #00D26A);
    padding: 24px 28px;
    margin: 40px 0;
    background: linear-gradient(90deg, var(--hf-accent-dim), transparent);
    border-radius: 0 8px 8px 0;
    color: var(--hf-text-secondary, #b0b0b0);
    font-size: 1rem;
    line-height: 1.8;
    box-shadow: 0 2px 12px rgba(0, 210, 106, 0.06);
  }
  .art-body blockquote::before {
    content: '\201C';
    font-family: 'Space Grotesk', serif;
    font-size: 3rem;
    color: var(--hf-accent, #00D26A);
    opacity: 0.3;
    position: absolute;
    top: 8px;
    left: 12px;
    line-height: 1;
    pointer-events: none;
  }
  .art-body code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    background: var(--hf-accent-dim);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--hf-accent, #00D26A);
    border: 1px solid var(--hf-accent-border, transparent);
  }
  .art-body pre {
    background: var(--hf-bg-code, var(--hf-bg-elevated, #1a1a1a));
    border: 1px solid var(--hf-border, #222222);
    border-radius: 10px;
    padding: 28px 28px 24px;
    overflow-x: auto;
    margin: 40px 0;
    position: relative;
  }
  .art-body pre::before {
    content: 'Python';
    display: inline-block;
    background: var(--hf-accent-dim);
    color: var(--hf-accent, #00D26A);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 3px 12px;
    border-radius: 6px;
    margin-bottom: 12px;
  }
  .art-body pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--hf-text-secondary, #cccccc);
    font-size: 0.85rem;
    line-height: 1.7;
  }
  .art-body hr {
    border: none;
    border-top: 1px solid var(--hf-border-secondary, #2a2a2a);
    margin: 64px 0;
    opacity: 0.4;
  }
  .art-body table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 40px 0;
    font-size: 0.85rem;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--hf-border, #3a3a3a);
  }
  .art-body th {
    background: var(--hf-accent-dim);
    font-weight: 600;
    color: var(--hf-accent, #00D26A);
    padding: 12px 16px;
    border-bottom: 1px solid var(--hf-border, #3a3a3a);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .art-body td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--hf-border-secondary, #2a2a2a);
    color: var(--hf-text-muted, #8a8a8a);
    vertical-align: top;
  }
  .art-body tr:last-child td { border-bottom: none; }
  .art-body tr:hover td { background: var(--hf-accent-dim); }
  .art-body a {
    color: var(--hf-accent, #00D26A);
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--hf-accent-dim);
    transition: text-decoration-color 0.2s;
  }
  .art-body a:hover {
    text-decoration-color: var(--hf-accent, #00D26A);
  }

  /* ── Closing Panel ── */
  .art-closing-panel {
    padding: 40px 24px;
    max-width: 820px;
    margin: 0 auto;
  }
  .art-closing-inner {
    background: transparent;
    border: none;
    padding: 0;
    position: relative;
    animation: none;
  }
  html[data-theme-mode="light"] .art-closing-inner {
    background: transparent;
    border: none;
    animation: none;
  }
  /* Chat banner */
  .art-chat-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    max-width: 400px;
    cursor: pointer;
    position: relative;
    border-radius: 12px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--hf-accent) 8%, transparent) 0%,
      color-mix(in srgb, var(--hf-accent) 3%, transparent) 100%
    );
    border: 1px solid color-mix(in srgb, var(--hf-accent) 20%, var(--hf-border));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s ease;
    animation: chatBannerPulse 4s ease-in-out 1s infinite;
    overflow: hidden;
  }
  html[data-theme-mode="light"] .art-chat-banner {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--hf-accent) 10%, white) 0%,
      color-mix(in srgb, var(--hf-accent) 4%, white) 100%
    );
    border-color: color-mix(in srgb, var(--hf-accent) 25%, #ddd);
  }
  @keyframes chatBannerPulse {
    0%, 100% { border-color: color-mix(in srgb, var(--hf-accent) 20%, var(--hf-border)); box-shadow: 0 0 0 0 transparent; }
    50% { border-color: color-mix(in srgb, var(--hf-accent) 45%, var(--hf-border)); box-shadow: 0 0 18px 1px color-mix(in srgb, var(--hf-accent) 8%, transparent); }
  }
  .chat-banner-glow {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: radial-gradient(ellipse at 30% 50%, color-mix(in srgb, var(--hf-accent) 12%, transparent) 0%, transparent 70%);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .art-chat-banner:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--hf-accent) 50%, var(--hf-border));
    box-shadow: 0 4px 24px color-mix(in srgb, var(--hf-accent) 12%, transparent);
    animation-play-state: paused;
  }
  .art-chat-banner:hover .chat-banner-glow {
    opacity: 1.5;
  }
  .chat-banner-content {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 24px;
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .chat-banner-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--hf-accent) 15%, transparent);
    color: var(--hf-accent, #00D26A);
    flex-shrink: 0;
    transition: all 0.3s ease;
  }
  .art-chat-banner:hover .chat-banner-icon {
    background: color-mix(in srgb, var(--hf-accent) 25%, transparent);
    transform: scale(1.05);
  }
  .chat-banner-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chat-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--hf-text, #fff);
    line-height: 1.3;
  }
  html[data-theme-mode="light"] .chat-banner-title {
    color: var(--hf-text, #1a1a18);
  }
  .chat-banner-sub {
    font-size: 0.7rem;
    color: var(--hf-text-muted, #888);
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .chat-banner-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hf-accent, #00D26A);
    flex-shrink: 0;
    animation: dotLive 2s ease-in-out infinite;
    box-shadow: 0 0 8px color-mix(in srgb, var(--hf-accent) 50%, transparent);
  }
  @keyframes dotLive {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  @keyframes border-glow {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 18px 1px var(--hf-accent-dim), 0 0 0 0 transparent; }
  }
  @keyframes border-glow-light {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 24px 3px rgba(0,150,90,0.15), 0 1px 4px rgba(0,0,0,0.06); }
