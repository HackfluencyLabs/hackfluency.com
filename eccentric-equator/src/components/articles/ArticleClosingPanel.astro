---
interface Props {
  locale: 'es' | 'en';
  slug: string;          // for Supabase (destellos) and Cusdis page-id
  pageTitle: string;     // for Cusdis data-page-title
  pageUrl: string;       // for Cusdis data-page-url
}

const { locale, slug, pageTitle, pageUrl } = Astro.props;
const cusdisId = slug + '-' + locale;
---

<div class="art-closing-panel">
  <div class="art-closing-inner">

    <!-- Reactions -->
    <div class="art-claps-box">
      <div class="art-claps" id="art-claps-root" data-slug={slug}>
        <span class="art-claps-count" id="art-claps-count">0</span>
        <button class="art-claps-btn" id="art-claps-btn" aria-label="React">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" stroke="none" style="position:absolute">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" opacity="0.15" transform="scale(1.5) translate(-4,-4)"/>
          </svg>
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" stroke="none">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        </button>
        <span class="art-claps-label">{locale === 'es' ? 'destellos' : 'sparkles'}</span>
      </div>
    </div>

    <!-- Comments -->
    <div class="art-comments-box">
    <div id="cusdis_thread"
      data-host="https://cusdis.com"
      data-app-id="90d95120-41f5-4baa-8285-8e91d4d96c45"
      data-page-id={cusdisId}
      data-page-url={pageUrl}
      data-page-title={pageTitle}
      data-lang={locale === 'es' ? 'es' : 'en'}
    ></div>

<script is:inline>
(function() {
  var thread = document.getElementById('cusdis_thread');
  if (!thread) return;

  function applyCusdisTheme() {
    var iframe = thread.querySelector('iframe');
    if (!iframe) return;
    try {
      var doc = iframe.contentDocument || iframe.contentWindow.document;
      if (!doc || !doc.documentElement || !doc.documentElement.classList) return;
      var isDark = document.documentElement.getAttribute('data-theme-mode') === 'dark';
      if (isDark) {
        doc.documentElement.classList.add('dark');
        var s = doc.querySelector('style');
        if (s) {
          s.textContent = s.textContent.replace('color-scheme: light', 'color-scheme: dark');
          if (!s.textContent.includes('/*hf-cusdis-btn*/')) {
            s.textContent += '/*hf-cusdis-btn*/.dark button.dark\\:bg-transparent{color:#e5e7eb!important}';
          }
        }
      } else {
        doc.documentElement.classList.remove('dark');
        var s = doc.querySelector('style');
        if (s) s.textContent = s.textContent.replace('color-scheme: dark', 'color-scheme: light');
      }
    } catch(e) {}
  }

  var observer = new MutationObserver(applyCusdisTheme);
  observer.observe(thread, { childList: true, subtree: true });

  setInterval(applyCusdisTheme, 800);

  var mode = document.documentElement.getAttribute('data-theme-mode') || 'dark';
  thread.setAttribute('data-theme', mode === 'light' ? 'light' : 'dark');
  setTimeout(applyCusdisTheme, 300);
  setTimeout(applyCusdisTheme, 1500);

  window.addEventListener('hf-theme-change', function() {
    var mode = document.documentElement.getAttribute('data-theme-mode') || 'dark';
    thread.setAttribute('data-theme', mode === 'light' ? 'light' : 'dark');
    applyCusdisTheme();
  });
})();
</script>
<script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
    </div>

  </div>
</div>

<!-- Destellos script -->
<script is:inline>
(function() {
  var root = document.getElementById('art-claps-root');
  if (!root) return;
  var slug = root.getAttribute('data-slug') || 'unknown';
  var key = 'hf_claps_' + slug;
  var btn = document.getElementById('art-claps-btn');
  var countEl = document.getElementById('art-claps-count');
  if (!btn || !countEl) return;
  var count = 0, clapped = localStorage.getItem(key) === 'true';

  function updateCount(n) { count = n; if (countEl) countEl.textContent = count; }

  function fetchCount(retries) {
    var controller = new AbortController();
    var timeout = setTimeout(function() { controller.abort(); }, 5000);
    fetch('https://yfofmawbvlontugygfcj.supabase.co/rest/v1/article_claps?slug=eq.' + slug + '&select=count', {
      headers: { 'apikey': 'sb_publishable_EFI12D4AaO2Y7o5gyWrB-g_i--T5Arz' },
      signal: controller.signal
    })
    .then(function(r) { clearTimeout(timeout); return r.json(); })
    .then(function(data) { if (data && data.length > 0) updateCount(data[0].count); })
    .catch(function() { clearTimeout(timeout); if (retries > 0) setTimeout(function() { fetchCount(retries - 1); }, 1500); });
  }
  fetchCount(3);

  if (btn) {
    btn.addEventListener('click', function() {
      if (clapped) return;
      clapped = true;
      localStorage.setItem(key, 'true');
      var newCount = count + 1;
      updateCount(newCount);
      btn.classList.add('clapped');
      fetch('https://yfofmawbvlontugygfcj.supabase.co/rest/v1/article_claps?onConflict=slug', {
        method: 'POST',
        headers: {
          'apikey': 'sb_publishable_EFI12D4AaO2Y7o5gyWrB-g_i--T5Arz',
          'Content-Type': 'application/json',
          'Prefer': 'resolution=merge-duplicates'
        },
        body: JSON.stringify({ slug: slug, count: newCount })
      }).catch(function() {});
    });
  }
})();
</script>

<style>
  .art-closing-panel {
    padding: 60px 24px;
    max-width: 820px;
    margin: 0 auto;
  }
  .art-closing-inner {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 40px;
    background: var(--hf-bg-card, #111);
    border: 1px solid var(--hf-border, #222);
    border-radius: 16px;
    padding: 40px 36px;
    position: relative;
    animation: hf-closing-glow 3s ease-in-out infinite;
  }
  html[data-theme-mode="light"] .art-closing-inner {
    background: var(--hf-bg-secondary, #ffffff);
    border-color: #dde0e6;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    animation: hf-closing-glow-light 3s ease-in-out infinite;
  }
  @keyframes hf-closing-glow {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 18px 1px var(--hf-accent-dim), 0 0 0 0 transparent; }
  }
  @keyframes hf-closing-glow-light {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 24px 3px rgba(0,150,90,0.15), 0 1px 4px rgba(0,0,0,0.06); }
  }

  .art-claps-box {
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid var(--hf-border-secondary, #2a2a2a);
    padding-right: 40px;
  }
  html[data-theme-mode="light"] .art-claps-box {
    border-color: #e0e4ea;
  }
  .art-claps {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .art-claps-btn {
    background: var(--hf-accent-dim);
    border: 2px solid var(--hf-accent-border, rgba(0,210,106,0.3));
    color: var(--hf-accent, #00D26A);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  html[data-theme-mode="light"] .art-claps-btn {
    background: var(--hf-accent-dim, rgba(0,150,90,0.08));
    border-color: var(--hf-accent-border, rgba(0,150,90,0.25));
    color: var(--hf-accent, #00965A);
  }
  .art-claps-btn svg:first-child {
    animation: hf-star-pulse 2s ease-in-out infinite;
  }
  .art-claps-btn svg:last-child {
    animation: hf-star-orbit 3s linear infinite;
    transform-origin: center;
  }
  @keyframes hf-star-pulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.08); opacity: 1; }
  }
  @keyframes hf-star-orbit {
    0% { transform: scale(1.35) translate(-3.5px,-3.5px) rotate(0deg); }
    100% { transform: scale(1.35) translate(-3.5px,-3.5px) rotate(360deg); }
  }
  .art-claps-btn:hover {
    border-color: var(--hf-accent, #00D26A);
    color: var(--hf-accent, #00D26A);
    transform: scale(1.08);
    box-shadow: 0 0 24px var(--hf-accent-dim);
  }
  .art-claps-btn.clapped {
    color: var(--hf-accent, #00D26A);
    border-color: var(--hf-accent, #00D26A);
    animation: hf-clap-pop 0.3s ease;
  }
  @keyframes hf-clap-pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.18); }
    100% { transform: scale(1); }
  }
  .art-claps-count {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--hf-accent, #00D26A);
    font-family: 'Space Grotesk', sans-serif;
  }
  .art-claps-label {
    font-size: 0.65rem;
    color: var(--hf-text-dim, #6a6a6a);
    text-transform: uppercase;
    letter-spacing: 2px;
  }
  .art-comments-box {
    min-width: 0;
  }
  #cusdis_thread {
    min-height: 200px;
  }
  #cusdis_thread iframe {
    border: none !important;
  }

  @media (max-width: 700px) {
    .art-closing-panel { padding: 40px 20px; }
    .art-closing-inner {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 28px 24px;
    }
    .art-claps-box {
      border-right: none;
      border-bottom: 1px solid var(--hf-border-secondary, #2a2a2a);
      padding-right: 0;
      padding-bottom: 24px;
    }
    .art-claps-btn { width: 60px; height: 60px; }
    .art-claps-btn svg { width: 36px; height: 36px; }
  }
</style>
