---
interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;
const isES = locale === 'es';
---

<div class="art-closing-panel">
  <div class="art-closing-inner">

    <!-- Chat banner -->
    <div class="art-chat-banner" id="art-chat-banner" role="button" tabindex="0" aria-label={isES ? 'Abrir chat' : 'Open chat'}>
      <div class="chat-banner-glow"></div>
      <div class="chat-banner-content">
        <span class="chat-banner-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
          </svg>
        </span>
        <span class="chat-banner-text">
          <span class="chat-banner-title">{isES ? 'Deja un mensaje' : 'Leave a message'}</span>
          <span class="chat-banner-sub">{isES ? 'Anónimo · Tiempo real · Otros usuarios conectados' : 'Anonymous · Live · Others are here'}</span>
        </span>
        <span class="chat-banner-dot"></span>
      </div>
    </div>

    <!-- Iine reaction button -->
    <div class="art-iine-box">
      <button class="iine-button" aria-hidden="true" data-icon="heart"></button>
    </div>

  </div>
</div>

<!-- Iine script -->
<script src="https://cdn.jsdelivr.net/gh/welpo/iine@main/iine.mini.js" data-astro-rerun></script>

<!-- Chat banner click handler -->
<script is:inline data-astro-rerun>
document.addEventListener('click', function(e) {
  var banner = e.target.closest('#art-chat-banner');
  if (!banner) return;
  var floating = document.getElementById('rt-d6023b7d7713a023f5e73ab154aa7c08');
  if (floating) {
    var img = floating.querySelector('img');
    if (img) img.click();
  }
});
</script>

<style>
  .art-closing-panel {
    padding: 40px 24px;
    max-width: 820px;
    margin: 0 auto;
  }
  .art-closing-inner {
    background: transparent;
    border: none;
    padding: 0;
    position: relative;
  }
  html[data-theme-mode="light"] .art-closing-inner {
    background: transparent;
    border: none;
  }

  @keyframes iineFadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes iinePulse {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 14px 1px var(--hf-accent-dim), 0 0 0 0 transparent; }
  }

  /* Chat banner */
  .art-chat-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    max-width: 400px;
    cursor: pointer;
    position: relative;
    border-radius: 12px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--hf-accent) 8%, transparent) 0%,
      color-mix(in srgb, var(--hf-accent) 3%, transparent) 100%
    );
    border: 1px solid color-mix(in srgb, var(--hf-accent) 20%, var(--hf-border));
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s ease;
    animation: chatBannerPulse 4s ease-in-out 1s infinite;
    overflow: hidden;
  }
  html[data-theme-mode="light"] .art-chat-banner {
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--hf-accent) 10%, white) 0%,
      color-mix(in srgb, var(--hf-accent) 4%, white) 100%
    );
    border-color: color-mix(in srgb, var(--hf-accent) 25%, #ddd);
  }
  @keyframes chatBannerPulse {
    0%, 100% { border-color: color-mix(in srgb, var(--hf-accent) 20%, var(--hf-border)); box-shadow: 0 0 0 0 transparent; }
    50% { border-color: color-mix(in srgb, var(--hf-accent) 45%, var(--hf-border)); box-shadow: 0 0 18px 1px color-mix(in srgb, var(--hf-accent) 8%, transparent); }
  }
  .chat-banner-glow {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: radial-gradient(ellipse at 30% 50%, color-mix(in srgb, var(--hf-accent) 12%, transparent) 0%, transparent 70%);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .art-chat-banner:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--hf-accent) 50%, var(--hf-border));
    box-shadow: 0 4px 24px color-mix(in srgb, var(--hf-accent) 12%, transparent);
    animation-play-state: paused;
  }
  .art-chat-banner:hover .chat-banner-glow {
    opacity: 1.5;
  }
  .chat-banner-content {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 24px;
    position: relative;
    z-index: 1;
    width: 100%;
  }
  .chat-banner-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--hf-accent) 15%, transparent);
    color: var(--hf-accent, #00D26A);
    flex-shrink: 0;
    transition: all 0.3s ease;
  }
  .art-chat-banner:hover .chat-banner-icon {
    background: color-mix(in srgb, var(--hf-accent) 25%, transparent);
    transform: scale(1.05);
  }
  .chat-banner-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .chat-banner-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--hf-text, #fff);
    line-height: 1.3;
  }
  html[data-theme-mode="light"] .chat-banner-title {
    color: var(--hf-text, #1a1a18);
  }
  .chat-banner-sub {
    font-size: 0.7rem;
    color: var(--hf-text-muted, #888);
    font-weight: 400;
    letter-spacing: 0.02em;
  }
  .chat-banner-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--hf-accent, #00D26A);
    flex-shrink: 0;
    animation: dotLive 2s ease-in-out infinite;
    box-shadow: 0 0 8px color-mix(in srgb, var(--hf-accent) 50%, transparent);
  }
  @keyframes dotLive {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  /* Iine button */
  .art-iine-box {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 4px 0 4px;
    animation: iineFadeIn 0.6s ease-out 0.2s both;
  }
  .iine-button {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    padding: 8px 18px !important;
    font-size: 0.9rem !important;
    font-family: 'Inter', system-ui, sans-serif !important;
    cursor: pointer !important;
    border: 1px solid var(--hf-accent-border, rgba(0,210,106,0.25)) !important;
    border-radius: 100px !important;
    background: var(--hf-accent-dim, rgba(0,210,106,0.05)) !important;
    color: var(--hf-text-muted, #888) !important;
    transition: all 0.3s ease !important;
    line-height: 1 !important;
    animation: iinePulse 4s ease-in-out 3s infinite !important;
  }
  .iine-button .icon {
    display: inline-flex !important;
    align-items: center !important;
  }
  .iine-button .icon svg {
    width: 18px !important;
    height: 18px !important;
  }
  .iine-button .counter {
    font-weight: 600 !important;
    font-variant-numeric: tabular-nums !important;
  }
  .iine-button.clicked {
    border-color: var(--hf-accent, #00D26A) !important;
    color: var(--hf-accent, #00D26A) !important;
    background: var(--hf-accent-dim, rgba(0,210,106,0.12)) !important;
  }

  @media (max-width: 700px) {
    .art-closing-panel { padding: 24px 20px; }
    .art-closing-inner { padding: 0; }
  }
</style>
