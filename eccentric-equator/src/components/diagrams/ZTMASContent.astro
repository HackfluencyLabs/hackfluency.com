<script>
(function() {
  const tabs = document.querySelectorAll('.zt-tab');
  const cards = document.getElementById('zt-cards');

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(function(t) { t.classList.remove('active'); });
      tab.classList.add('active');
      const view = tab.dataset.view;
      cards.classList.remove('single', 'single-a', 'single-b');
      if (view === 'a') { cards.classList.add('single', 'single-a'); }
      else if (view === 'b') { cards.classList.add('single', 'single-b'); }
    });
  });
})();
</script>
