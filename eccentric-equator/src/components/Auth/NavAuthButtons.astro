---
// NavAuthButtons.astro — 100% vanilla. Sin React ni SDK Supabase.
// Mismo contrato que el componente React que reemplaza:
//  - Estado anónimo: render estático server-side (2 links). Zero JS.
//  - Estado logueado: el script lee la sesión de Supabase desde
//    localStorage (clave `sb-*-auth-token`) y revela el dropdown/menu.
//  - Logout: POST /auth/v1/logout (igual que supabase.auth.signOut())
//    + limpieza de localStorage + reload.
import './auth.css';
import { getTranslations } from '../../i18n/utils';
import type { Language } from '../../i18n/translations';

interface Props {
  mobile?: boolean;
  locale?: Language;
}
const { mobile = false, locale = 'es' } = Astro.props;
const { t } = getTranslations(locale);
const dashboardsUrl = locale === 'es' ? '/dashboards' : '/en/dashboards';
const ctiUrl = locale === 'es' ? '/cti/' : '/en/cti/';
const contactUrl = locale === 'es' ? '/#contact' : '/en#contact';
---

{
  mobile ? (
    <div class="nav-auth-mobile" data-nav-auth transition:persist>
      {/* Estado anónimo (default server-side, sin JS) */}
      <div data-nav-auth-anon>
        <a href={dashboardsUrl} class="mobile-nav-btn-signin">{t('nav.signIn')}</a>
        <a href={contactUrl} class="mobile-nav-cta" style="color: #ffffff">{t('common.bookCall')}</a>
      </div>
      {/* Estado logueado (oculto hasta que el script detecte sesión) */}
      <div data-nav-auth-session hidden>
        <a href={ctiUrl} class="mobile-nav-btn-threat">{t('nav.threatIntel')}</a>
        <a href={dashboardsUrl} class="mobile-nav-btn-platform">{t('nav.dashboards')}</a>
        <button type="button" class="mobile-nav-btn-logout" data-nav-logout>{t('nav.logOut')}</button>
        <a href={contactUrl} class="mobile-nav-cta" style="color: #ffffff">{t('common.bookCall')}</a>
      </div>
    </div>
  ) : (
    <div class="nav-auth" data-nav-auth transition:persist>
      {/* Estado anónimo (default server-side, sin JS) */}
      <div data-nav-auth-anon>
        <a href={dashboardsUrl} class="nav-btn-dashboard">{t('nav.signIn')}</a>
        <a href={contactUrl} class="nav-cta" style="color: #ffffff">{t('common.bookCall')}</a>
      </div>
      {/* Estado logueado (oculto hasta que el script detecte sesión) */}
      <div data-nav-auth-session hidden>
        <div class="nav-dropdown" data-nav-dropdown>
          <button
            type="button"
            class="nav-dropdown-toggle"
            aria-expanded="false"
            aria-label={t('nav.account')}
            data-nav-toggle
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="8" r="4"/>
              <path d="M20 21a8 8 0 1 0-16 0"/>
            </svg>
            <span class="nav-dropdown-label">{t('nav.accountLabel')}</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="nav-dropdown-chevron" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <div class="nav-dropdown-menu" data-nav-menu hidden>
            <a href={ctiUrl} class="nav-dropdown-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              {t('nav.threatIntel')}
            </a>
            <a href={dashboardsUrl} class="nav-dropdown-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="18" rx="1"/><rect x="14" y="9" width="7" height="12" rx="1"/></svg>
              {t('nav.dashboards')}
            </a>
            <div class="nav-dropdown-divider" />
            <button type="button" class="nav-dropdown-item nav-dropdown-item--danger" data-nav-logout>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
              {t('nav.logOut')}
            </button>
          </div>
        </div>
        <a href={contactUrl} class="nav-cta" style="color: #ffffff">{t('common.bookCall')}</a>
      </div>
    </div>
  )
}

<script>
  // Vanilla. Lee la sesión de Supabase directamente de localStorage
  // (la clave que usa supabase-js v2: `sb-<ref>-auth-token`). Sin red,
  // sin SDK. Replica el contrato del NavAuthButtons React.
  import.meta.env.PUBLIC_SUPABASE_URL;
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  const SUPABASE_URL: string = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY: string = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  function getSessionToken(): string | null {
    // supabase-js persiste la sesión en `sb-<ref>-auth-token`.
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && /^sb-.+-auth-token$/.test(key)) {
        try {
          const raw = localStorage.getItem(key);
          if (!raw) return null;
          const data = JSON.parse(raw);
          if (data && typeof data.access_token === 'string' && data.access_token) {
            return data.access_token;
          }
        } catch {
          /* token corrupto — se trata como sesión no detectada */
        }
      }
    }
    return null;
  }

  function clearSupabaseStorage(): void {
    const doomed: string[] = [];
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.startsWith('sb-')) doomed.push(key);
    }
    doomed.forEach((k) => localStorage.removeItem(k));
  }

  async function signOut(): Promise<void> {
    const token = getSessionToken();
    // Revocación server-side (igual que supabase.auth.signOut()).
    // Si la red falla, aun así limpiamos storage y recargamos.
    if (token) {
      try {
        await fetch(`${SUPABASE_URL}/auth/v1/logout`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({}),
        });
      } catch {
        /* offline — el storage se limpia igual */
      }
    }
    clearSupabaseStorage();
    window.location.reload();
  }

  function applySessionState(): void {
    const hasSession = !!getSessionToken();
    document.querySelectorAll<HTMLElement>('[data-nav-auth]').forEach((root) => {
      const anon = root.querySelector<HTMLElement>('[data-nav-auth-anon]');
      const session = root.querySelector<HTMLElement>('[data-nav-auth-session]');
      if (!anon || !session) return;
      anon.hidden = hasSession;
      session.hidden = !hasSession;
    });
  }

  // Guard anti-doble-init en navegaciones SPA (el DOM persiste con transition:persist)
  const doc = document;
  if (!doc.querySelector('[data-nav-auth]')) {
    // Sin islas en esta página — no hay nada que hacer.
  } else {
    const root = doc.querySelector<HTMLElement>('[data-nav-auth]')!;
    if (!root.dataset.navInit) {
      root.dataset.navInit = '1';

      doc.querySelectorAll<HTMLElement>('[data-nav-toggle]').forEach((toggle) => {
        toggle.addEventListener('click', () => {
          const menu = toggle.parentElement?.querySelector<HTMLElement>('[data-nav-menu]');
          if (!menu) return;
          const open = menu.hidden;
          menu.hidden = !open;
          toggle.setAttribute('aria-expanded', String(open));
          toggle.querySelector('.nav-dropdown-chevron')?.classList.toggle('open', open);
        });
      });

      doc.querySelectorAll<HTMLButtonElement>('[data-nav-logout]').forEach((btn) => {
        btn.addEventListener('click', () => {
          void signOut();
        });
      });

      // Cerrar dropdown con clic fuera y Escape
      doc.addEventListener('mousedown', (e) => {
        doc.querySelectorAll<HTMLElement>('[data-nav-dropdown]').forEach((dd) => {
          if (dd.contains(e.target as Node)) return;
          const menu = dd.querySelector<HTMLElement>('[data-nav-menu]');
          const toggle = dd.querySelector<HTMLElement>('[data-nav-toggle]');
          if (menu && !menu.hidden) {
            menu.hidden = true;
            toggle?.setAttribute('aria-expanded', 'false');
            toggle?.querySelector('.nav-dropdown-chevron')?.classList.remove('open');
          }
        });
      });
      doc.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        doc.querySelectorAll<HTMLElement>('[data-nav-menu]').forEach((menu) => {
          menu.hidden = true;
        });
        doc.querySelectorAll<HTMLElement>('[data-nav-toggle]').forEach((t) => {
          t.setAttribute('aria-expanded', 'false');
          t.querySelector('.nav-dropdown-chevron')?.classList.remove('open');
        });
      });

      // Reaccionar a login/logout en otra pestaña o navegación SPA
      window.addEventListener('storage', applySessionState);
      doc.addEventListener('astro:after-swap', applySessionState);
    }
  }

  applySessionState();
</script>