---
import SubscriptionPopup from '../components/SubscriptionPopup.astro';
import PdfDownloadGate from '../components/articles/PdfDownloadGate.astro';
import { ClientRouter } from 'astro:transitions';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeSelector from '../components/ThemeSelector.astro';
import LanguageSelector from '../components/LanguageSelector.astro';
import { getTranslations } from '../i18n/utils';
import type { Language } from '../i18n/translations';

export interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogImage?: string;
  ogType?: string;
  hideThemeSelector?: boolean;
  locale?: Language;
  robots?: string;
  viewportDesktop?: boolean;
  enableGlobalEcharts?: boolean;
}

const {
  title = "Hackfluency — Observatorio de Sistemas Complejos | Ciberseguridad, IA & Regulatorio Chile",
  description = "Investigaci\u00F3n aplicada en ciberseguridad, inteligencia artificial y convergencia regulatoria. An\u00E1lisis, instrumentos y evidencia para Chile y LATAM.",
  ogImage = "/HFNeon.png",
  ogType = "website",
  hideThemeSelector = false,
  locale = 'es',
  robots = 'index, follow',
  viewportDesktop = false,
  enableGlobalEcharts = false,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();

// Hreflang URLs
const esURL = new URL(currentPath.replace(/^\/en(\/|$)/, '/'), Astro.site).toString();
const enURL = new URL(`/en${currentPath === '/' ? '' : currentPath}`, Astro.site).toString();
// Avoid double /en/en
const enCanonical = currentPath.startsWith('/en/') || currentPath === '/en'
  ? canonicalURL
  : currentPath === '/'
    ? new URL('/en', Astro.site).toString()
    : new URL(`/en${currentPath}`, Astro.site).toString();

const { t } = getTranslations(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={viewportDesktop ? 'width=1200, minimum-scale=0.25, maximum-scale=5, user-scalable=yes' : 'width=device-width, initial-scale=1.0, user-scalable=yes'} />
    {viewportDesktop && <script is:inline data-astro-rerun>document.querySelector('meta[name="viewport"]')?.setAttribute('content','width=1200, minimum-scale=0.25, maximum-scale=5, user-scalable=yes');</script>}
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      script-src 'self' 'unsafe-inline' 'unsafe-eval'
        https://cdn.jsdelivr.net
        https://rumbletalk.com
        https://widget.trustpilot.com
        http://widget.trustpilot.com
        https://*.trustpilot.com
        https://fonts.googleapis.com
        https://unpkg.com;
      style-src 'self' 'unsafe-inline'
        https://fonts.googleapis.com
        https://rumbletalk.com;
      font-src 'self'
        https://fonts.gstatic.com
        data:;
      img-src 'self' https: data:;
      connect-src 'self'
        https://api.telegram.org
        https://rumbletalk.com
        https://*.rumbletalk.net
        wss://*.rumbletalk.net
        https://widget.trustpilot.com
        http://widget.trustpilot.com
        https://*.trustpilot.com
        https://yfofmawbvlontugygfcj.supabase.co
        https://vhiweeypifbwacashxjz.supabase.co;
      frame-src 'self'
        https://rumbletalk.com
        https://*.rumbletalk.net
        https://*.trustpilot.com;
      form-action 'self'
        https://api.telegram.org;
      base-uri 'self';
      manifest-src 'self';
    ">
    {enableGlobalEcharts && <script src="https://cdn.jsdelivr.net/npm/echarts@5.5.1/dist/echarts.min.js"></script>}
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon.png`} />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <link rel="apple-touch-icon" href={`${base}favicon.png`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang -->
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enCanonical} />
    <link rel="alternate" hreflang="x-default" href={esURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Hackfluency" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />

    <slot name="head" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@hackfluency" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Space+Grotesk:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" media="print" onload="this.media='all';this.onload=null;">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Space+Grotesk:wght@500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet"></noscript>

    <title>{title}</title>
    <ClientRouter />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Hackfluency",
      "url": canonicalURL,
      "description": description,
      "foundingDate": "2024",
      "email": "inquiry@hackfluency.com",
      "logo": `${base}HFNeon.png`,
      "sameAs": [
        "https://www.linkedin.com/company/hackfluency",
      ],
      "knowsAbout": [
        "Complex Systems",
        "Cybersecurity Architecture",
        "AI Systems Engineering",
        "Organizational Behavior",
        "Intelligence Analysis",
        "Sociotechnical Systems",
      ],
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Hackfluency",
      "url": `https://www.hackfluency.com${currentPath}`,
      "description": description,
      "inLanguage": locale === 'es' ? 'es-ES' : 'en-US',
    })} />

    <!-- Theme flash prevention -->
    <ThemeInit />

    <!-- Language redirect on first visit (only for root /) -->
    {locale === 'es' && (
      <script is:inline>
        (function() {
          if (window.location.pathname !== '/' && window.location.pathname !== '') return;
          if (localStorage.getItem('hf-language')) return;
          var lang = navigator.language || navigator.language || '';
          if (lang.startsWith('en')) {
            localStorage.setItem('hf-language', 'en');
            window.location.replace('/en');
          } else {
            localStorage.setItem('hf-language', 'es');
          }
        })();
      </script>
    )}
  </head>
  <body>
    <!-- Skip link for keyboard navigation -->
    <a href="#main-content" class="skip-link">{locale === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}</a>
    <slot />
    <SubscriptionPopup locale={locale} />
    <PdfDownloadGate locale={locale} />
    {!hideThemeSelector && <ThemeSelector variant="floating" />}

    <!-- RumbleTalk embed (hidden container, click toggles chat) -->
    <div id="rt-d6023b7d7713a023f5e73ab154aa7c08" data-floating="true" data-side="left" data-width="700" data-height="500"
      data-image="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="
      style="position:fixed; bottom:0; left:0; z-index:2147483000;" transition:persist="hf-rt">
    </div>

    <!-- Custom floating button -->
    <button type="button" id="hf-fab" class="hf-fab" aria-label="Conversar">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 11a2 2 0 0 1-2 2H5l-3 3V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2z" opacity="0.35" style="translate:-4px -3px"/>
        <path d="M21 15a2 2 0 0 1-2 2H9l-3 3V9a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2z"/>
      </svg>
    </button>

    <style>
      .hf-fab {
        position: fixed; bottom: 24px; left: 24px; z-index: 2147483000;
        width: 54px; height: 54px; border-radius: 50%;
        background: linear-gradient(135deg, #00D26A, #00994D);
        color: #0a0a0a; border: none; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 4px 20px rgba(0,210,106,0.3);
        transition: transform 0.2s, box-shadow 0.2s;
        animation: hfPop 0.5s cubic-bezier(0.34,1.56,0.64,1);
      }
      @keyframes hfPop { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
      .hf-fab:hover { transform: scale(1.12); box-shadow: 0 6px 30px rgba(0,210,106,0.5); }
      .hf-fab:active { transform: scale(0.92); }
      .hf-fab svg { width: 24px; height: 24px; }
    </style>

    <script is:inline data-astro-rerun>
    (function(){
      var c = document.getElementById('rt-d6023b7d7713a023f5e73ab154aa7c08');
      var fab = document.getElementById('hf-fab');
      if (!c || !fab) return;

      // Defer the cross-origin RumbleTalk SDK until first interaction,
      // keeping the state-based detection so the SPA fix survives View Transitions.
      var sdkLoaded = false;
      var needsLauncher = function() {
        for (var i = 0; i < c.children.length; i++) {
          var ch = c.children[i];
          if (ch.tagName === 'IMG' || (ch.tagName === 'DIV' && ch.getBoundingClientRect().height > 0)) { return false; }
        }
        return true;
      };
      function loadSdk() {
        sdkLoaded = true;
        // Only inject if the launcher isn't already present (re-enter after a swap)
        if (!needsLauncher()) return;
        var s = document.createElement('script');
        s.src = 'https://rumbletalk.com/client/?1Yejiy6L';
        s.async = true;
        document.body.appendChild(s);
      }

      // Ring until first click
      var KEY = 'hf-ring';
      var up = true;
      var ring;

      function startRing() {
        if (localStorage.getItem(KEY)) return;
        ring = setInterval(function() {
          up = !up;
          fab.style.transform = up ? 'scale(1)' : 'scale(1.08)';
          fab.style.boxShadow = up ? '0 4px 20px rgba(0,210,106,0.3)' : '0 0 40px 12px rgba(0,210,106,0.6)';
        }, 700);
      }
      startRing();

      // Real open state = the RumbleTalk panel DIV is visible and sized
      function isOpen() {
        for (var i = 0; i < c.children.length; i++) {
          var k = c.children[i];
          if (k.tagName === 'DIV' &&
              getComputedStyle(k).visibility === 'visible' &&
              k.getBoundingClientRect().height >= 50) {
            return true;
          }
        }
        return false;
      }

      // Sync the FAB with the widget's REAL state (open = hide FAB, closed = show)
      function sync() {
        if (isOpen()) {
          clearInterval(ring);
          localStorage.setItem(KEY, '1');
          fab.style.display = 'none';
        } else {
          fab.style.display = 'flex';
        }
      }

      // Re-sync whenever the widget's DOM changes (open via X, close via X, etc.)
      try {
        new MutationObserver(sync).observe(c, { childList: true, subtree: true, attributes: true, attributeFilter: ['style', 'class'] });
      } catch (e) {}
      // Safety net for attribute-less style changes
      setInterval(sync, 800);

      // Load the SDK lazily on first engagement with the FAB (keeps cross-origin script off the critical path)
      fab.addEventListener('pointerdown', function() { if (!sdkLoaded) { loadSdk(); } });
      fab.addEventListener('click', function() {
        loadSdk();
        // Mobile: open in new tab (RumbleTalk inline doesn't work on mobile)
        if (window.innerWidth < 768) {
          window.open('https://rumbletalk.com/client/chat.php?1Yejiy6L', '_blank', 'noopener');
          return;
        }
        var img = c.querySelector('img');
        if (img) img.click();   // toggle the widget via its launcher
        sync();                 // reflect state immediately
      });
      sync();
    })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* ── Brand Colors — Defaults (overridden by theme system) ── */
    --primary: #00D26A;
    --primary-light: #00FF7F;
    --primary-dark: #00B359;
    --primary-glow: rgba(0, 255, 127, 0.6);
    --accent: #E31B23;
    --accent-light: #FF2D35;
    --accent-dark: #C41920;
    --accent-glow: rgba(227, 27, 35, 0.5);
    
    /* Neutrals */
    --black: #0a0a0a;
    --dark: #111111;
    --dark-lighter: #1a1a1a;
    --gray-900: #1f1f1f;
    --gray-800: #2a2a2a;
    --gray-700: #3a3a3a;
    --gray-600: #5a5a5a;
    --gray-500: #7a7a7a;
    --gray-400: #9a9a9a;
    --gray-300: #aaaaaa;
    --gray-200: #cccccc;
    --gray-100: #e5e5e5;
    --white: #ffffff;
    
    /* Gradients */
    --gradient-primary: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    --gradient-accent: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
    --gradient-dark: linear-gradient(180deg, var(--black) 0%, var(--dark) 100%);
    --gradient-glow: radial-gradient(ellipse at center, rgba(0, 210, 106, 0.2) 0%, transparent 70%);
    --gradient-neon: linear-gradient(135deg, var(--primary) 0%, #00FFAA 50%, var(--primary-light) 100%);

    /* ── HF Theme Tokens — Defaults (set via JS on <html>) ── */
    --hf-accent: #00D26A;
    --hf-accent-light: #00FF7F;
    --hf-accent-dark: #00B359;
    --hf-accent-glow: rgba(0, 210, 106, 0.6);
    --hf-accent-dim: rgba(0, 210, 106, 0.1);
    --hf-accent-border: rgba(0, 210, 106, 0.3);
    --hf-accent-secondary: #E31B23;
    --hf-accent-human: #9C5E4D;
    --hf-accent-privacy: #1E3A5F;
    --hf-accent-analysis: #6C4F9E;
    --hf-accent-philosophy: #7A6A4E;
    --hf-bg: #0a0a0a;
    --hf-bg-secondary: #111111;
    --hf-bg-card: #111111;
    --hf-bg-tertiary: #0d0d0d;
    --hf-bg-code: #000000;
    --hf-bg-track: #1a1a1a;
    --hf-bg-elevated: #1a1a1a;
    --hf-border: #222222;
    --hf-border-secondary: #2e2e2e;
    --hf-border-subtle: rgba(255, 255, 255, 0.1);
    --hf-text: #ffffff;
    --hf-text-secondary: #cccccc;
    --hf-text-muted: #888888;
    --hf-text-dim: #666666;
    --hf-text-disabled: #444444;
    --hf-text-on-accent: #000000;
    --hf-tab-border: #333333;
    --hf-nav-bg: linear-gradient(180deg, #1a1a1a 0%, #0f0f0f 100%);
    --hf-nav-border: #2a2a2a;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--hf-bg, #0a0a0a);
    color: var(--hf-text, #ffffff);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  /* ── Brand accent extensions ── */
  :root {

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    line-height: 1.2;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  /* Skip link for accessibility */
  .skip-link {
    position: absolute;
    top: -100%;
    left: 50%;
    transform: translateX(-50%);
    background: var(--primary, #00D26A);
    color: var(--hf-text-on-accent, #000);
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    z-index: 99999;
    transition: top 0.3s ease;
  }

  .skip-link:focus {
    top: 16px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--hf-bg-secondary, #111);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--hf-border-secondary, #3a3a3a);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--hf-accent, #00D26A);
  }

  /* Selection */
  ::selection {
    background: var(--hf-accent, #00D26A);
    color: var(--hf-text-on-accent, #000);
  }

  /* Utility Classes */
  .container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  @media (min-width: 768px) {
    .container {
      padding: 0 48px;
    }
  }

  @media (min-width: 1024px) {
    .container {
      padding: 0 64px;
    }
  }


</style>
