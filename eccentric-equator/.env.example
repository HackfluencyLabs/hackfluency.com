# ============================================================================
# VARIABLES DE ENTORNO
# ============================================================================
# Copiar a .env para desarrollo local. En producción se inyectan desde
# GitHub Actions (ver .github/workflows/deploy.yml).
#
# NOTA: el prefijo PUBLIC_ significa que el valor termina en el bundle del
# navegador. Nunca poner secretos con ese prefijo.
# ============================================================================

# ----------------------------------------------------------------------------
# FORMULARIO DE CONTACTO
# ----------------------------------------------------------------------------
# URL del Worker que recibe { name, email, message } y lo reenvía a Telegram.
# Ver worker/README.md.
# Si queda vacío, el formulario cae en un mailto: a inquiry@hackfluency.com.
PUBLIC_CONTACT_ENDPOINT=
